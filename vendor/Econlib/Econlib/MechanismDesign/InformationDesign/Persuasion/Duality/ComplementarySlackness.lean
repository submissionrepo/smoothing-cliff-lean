/-!
# Complementary slackness

For a Bayes-plausible distribution of posteriors and a Lipschitz dual-feasible price, the duality
gap closes on the pair iff the active-hyperplane condition `V(μ) = ∫ p dμ` holds for almost every
posterior in the distribution's support.

Economically: The income generated by every operated production process exactly equals its cost
under the supporting prices.

## Main statements

* `complementarySlackness` — `primalValue τ = dualObjective p` iff `V(μ) = ∫ p dμ` `τ`-a.e.

## References

* Dworczak, Piotr, and Anton Kolotilin. 2024. “The Persuasion Duality.” *Theoretical Economics* 19
  (4): 1701–55. [https://doi.org/10.3982/te5900](https://doi.org/10.3982/te5900). Corollary 1.

## Tags

persuasion, duality, complementary slackness
-/

@[expose] public section

open MeasureTheory Set BoundedContinuousFunction NNReal
open scoped Topology

namespace Econlib.MechanismDesign.InformationDesign.Persuasion.Duality

open Econlib.Probability
open Econlib.Optimization.OptimalTransport

/-! ## Complementary slackness -/

section ComplementarySlackness

variable {Ω : Type*} [PseudoMetricSpace Ω] [MeasurableSpace Ω] [OpensMeasurableSpace Ω]
  [CompactSpace Ω]

omit [OpensMeasurableSpace Ω] in
/-- **Complementary slackness — duality-gap form.**

For a Bayes-plausible `τ` and a dual-feasible price `p`, the duality gap closes on this pair
(`primalValue V τ = dualObjective μ₀ p`) iff the slackness condition `V(μ) = ∫ p dμ` holds for
`τ`-almost every `μ`.

When strong duality holds (so the common value `concaveClosure V μ₀ = dualValue V μ₀` is achieved),
this characterizes optimal `τ` and optimal `p` by complementary slackness on `supp(τ)`. -/
theorem complementarySlackness
    {V : ProbDist Ω → ℝ} {μ₀ : ProbDist Ω} {τ : ProbDist (ProbDist Ω)}
    {p : Ω → ℝ}
    (hV_int : Integrable V τ.toMeasure)
    (hg_int : Integrable (fun μ : ProbDist Ω => ProbDist.expect μ p) τ.toMeasure)
    (hτ : IsBayesPlausible μ₀ τ) (hp : IsDualFeasible V p) :
    primalValue V τ = dualObjective μ₀ p ↔
      (∀ᵐ μ ∂τ.toMeasure, V μ = ProbDist.expect μ p) := by
  let pBCF : Ω →ᵇ ℝ := lipschitzToBounded hp.lipschitz
  have hBayes :
      ∫ μ, ProbDist.expect μ p ∂τ.toMeasure = ProbDist.expect μ₀ p :=
    hτ pBCF
  have hslack_nn :
      ∀ᵐ μ ∂τ.toMeasure, 0 ≤ ProbDist.expect μ p - V μ :=
    Filter.Eventually.of_forall fun μ => sub_nonneg.mpr (hp.majorizes μ)
  have hslack_int :
      Integrable (fun μ : ProbDist Ω => ProbDist.expect μ p - V μ) τ.toMeasure :=
    hg_int.sub hV_int
  have hslack_eq :
      ∫ μ, (ProbDist.expect μ p - V μ) ∂τ.toMeasure
        = dualObjective μ₀ p - primalValue V τ := by
    rw [integral_sub hg_int hV_int, hBayes]
    rfl
  constructor
  · intro hgap
    have h0 : ∫ μ, (ProbDist.expect μ p - V μ) ∂τ.toMeasure = 0 := by
      rw [hslack_eq]; linarith
    have h_slack_zero :
        (fun μ : ProbDist Ω => ProbDist.expect μ p - V μ) =ᵐ[τ.toMeasure] 0 :=
      (MeasureTheory.integral_eq_zero_iff_of_nonneg_ae hslack_nn hslack_int).mp h0
    filter_upwards [h_slack_zero] with μ hμ
    -- `hμ` says `expect μ p - V μ = 0`; rearrange to the slackness equality.
    exact ((sub_eq_zero.mp (by simpa using hμ)).symm)
  · intro hae
    have h0 : ∫ μ, (ProbDist.expect μ p - V μ) ∂τ.toMeasure = 0 := by
      apply integral_eq_zero_of_ae
      filter_upwards [hae] with μ hμ
      simp [hμ]
    rw [hslack_eq] at h0
    linarith

end ComplementarySlackness

end Econlib.MechanismDesign.InformationDesign.Persuasion.Duality
