/-!
# Borel σ-algebra on `FiniteMeasure Ω` and `ProbabilityMeasure Ω`

Mathlib equips `FiniteMeasure Ω` and `ProbabilityMeasure Ω` with both a measurable space (the Giry
σ-algebra, inherited as a subtype of `Measure Ω`) and a topology (weak-* convergence, induced from
`WeakDual ℝ≥0 (Ω →ᵇ ℝ≥0)`), but does not prove they coincide. For `Ω` a compact second-countable
metrizable Borel space, the weak-* Borel σ-algebra on `ProbabilityMeasure Ω` agrees with its Giry
σ-algebra, the classical Aliprantis–Border / Parthasarathy fact.

## Main statements

* `MeasureTheory.instBorelSpaceProbabilityMeasure`: `ProbabilityMeasure Ω` is a `BorelSpace` for
  the weak-* topology and the Giry σ-algebra.
* `Econlib.Probability.instBorelSpaceProbDist`: The wrapper `ProbDist Ω` inherits this instance.

## Notes

The `ProbabilityMeasure` instance assumes `[CompactSpace Ω] [T2Space Ω] [BorelSpace Ω]`
`[PseudoMetrizableSpace Ω] [SecondCountableTopology Ω]`. Compactness and metrizability give
second-countability of `ProbabilityMeasure Ω` in the weak-* topology, so its Borel σ-algebra is
generated by a countable subbasis. These assumptions are already present at every Econlib use site,
so the instance resolves throughout the library without extra hypotheses.

The `FiniteMeasure` analog would need second-countability of `FiniteMeasure Ω`, which is
unavailable at this generality, so only the inclusion `giry_le_borel` is proved for
`FiniteMeasure Ω`.

## Tags

borel σ-algebra, probability measure, finite measure, weak-* topology, giry monad
-/

@[expose] public section

open Filter MeasureTheory Set TopologicalSpace
open scoped Topology ENNReal NNReal BoundedContinuousFunction

namespace MeasureTheory

namespace FiniteMeasure

/-! ## Giry σ-algebra ≤ Borel σ-algebra

For any measurable `A ⊆ Ω`, the evaluation `μ ↦ (μ : Measure Ω) A` is Borel-measurable on
`FiniteMeasure Ω` in the weak-* topology. -/

section

variable {Ω : Type*} [MeasurableSpace Ω] [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
  [HasOuterApproxClosed Ω]

/-- For closed `F ⊆ Ω`, the sub-level set `{μ | μ F < a}` is open in the weak-* topology on
`FiniteMeasure Ω`. -/
private lemma isOpen_setOf_measure_isClosed_lt {F : Set Ω} (hF : IsClosed F) (a : ℝ≥0∞) :
    IsOpen {μ : FiniteMeasure Ω | (μ : Measure Ω) F < a} := by
  set fs := hF.apprSeq with hfs
  have key : {μ : FiniteMeasure Ω | (μ : Measure Ω) F < a}
      = ⋃ n, {μ : FiniteMeasure Ω | (∫⁻ ω, (fs n ω : ℝ≥0∞) ∂(μ : Measure Ω)) < a} := by
    apply Set.eq_of_subset_of_subset
    · intro μ hμ
      have h_tendsto : Tendsto (fun n ↦ ∫⁻ ω, (fs n ω : ℝ≥0∞) ∂(μ : Measure Ω))
          atTop (𝓝 ((μ : Measure Ω) F)) :=
        HasOuterApproxClosed.tendsto_lintegral_apprSeq hF (μ : Measure Ω)
      obtain ⟨N, hN⟩ := (h_tendsto.eventually (eventually_lt_nhds hμ)).exists
      exact mem_iUnion.mpr ⟨N, hN⟩
    · intro μ hμ
      obtain ⟨N, hN⟩ := mem_iUnion.mp hμ
      exact lt_of_le_of_lt (HasOuterApproxClosed.measure_le_lintegral hF (μ : Measure Ω) N) hN
  rw [key]
  refine isOpen_iUnion fun N => ?_
  exact (FiniteMeasure.continuous_lintegral_boundedContinuousFunction
    (fs N)).isOpen_preimage _ isOpen_Iio

end

section

variable {Ω : Type*} [MeasurableSpace Ω] [TopologicalSpace Ω] [BorelSpace Ω]
  [PseudoMetrizableSpace Ω]

/-- The evaluation `μ ↦ μ A` on `FiniteMeasure Ω` is measurable from the Borel σ-algebra of the
weak-* topology to the Borel σ-algebra of `ℝ≥0∞`, for every measurable `A ⊆ Ω`. -/
private lemma borel_measurable_eval {A : Set Ω} (hA : MeasurableSet A) :
    @Measurable (FiniteMeasure Ω) ℝ≥0∞ (borel (FiniteMeasure Ω)) _
      (fun μ : FiniteMeasure Ω => (μ : Measure Ω) A) := by
  letI : MeasurableSpace (FiniteMeasure Ω) := borel (FiniteMeasure Ω)
  haveI : BorelSpace (FiniteMeasure Ω) := ⟨rfl⟩
  have h_closed : ∀ F : Set Ω, IsClosed F →
      Measurable (fun μ : FiniteMeasure Ω => (μ : Measure Ω) F) := by
    intro F hF
    exact measurable_of_Iio fun a => (isOpen_setOf_measure_isClosed_lt hF a).measurableSet
  have h_mass : Measurable (fun μ : FiniteMeasure Ω => (μ : Measure Ω) univ) :=
    h_closed _ isClosed_univ
  refine MeasurableSpace.induction_on_inter
    (h_eq := BorelSpace.measurable_eq.trans borel_eq_generateFrom_isClosed)
    (h_inter := isPiSystem_isClosed)
    (empty := ?empty) (basic := ?basic) (compl := ?compl) (iUnion := ?iUnion) A hA
  case empty =>
    simp only [measure_empty]
    exact measurable_const
  case basic =>
    intro t ht
    exact h_closed t ht
  case compl =>
    intro t htm h_meas_t
    have h_fin : ∀ μ : FiniteMeasure Ω, (μ : Measure Ω) t ≠ ∞ := fun μ =>
      (measure_lt_top (μ : Measure Ω) t).ne
    have h_eq : (fun μ : FiniteMeasure Ω => (μ : Measure Ω) tᶜ)
        = fun μ : FiniteMeasure Ω => (μ : Measure Ω) univ - (μ : Measure Ω) t := by
      funext μ
      exact measure_compl htm (h_fin μ)
    rw [h_eq]
    exact h_mass.sub h_meas_t
  case iUnion =>
    intro f hf_disj hf_meas h_meas_each
    have h_eq : (fun μ : FiniteMeasure Ω => (μ : Measure Ω) (⋃ i, f i))
        = fun μ : FiniteMeasure Ω => ∑' i, (μ : Measure Ω) (f i) := by
      funext μ
      exact measure_iUnion hf_disj hf_meas
    rw [h_eq]
    exact Measurable.ennreal_tsum h_meas_each

/-- The Giry σ-algebra on `FiniteMeasure Ω` is contained in the Borel σ-algebra of the weak-*
topology. -/
private lemma giry_le_borel :
    (FiniteMeasure.instMeasurableSpace : MeasurableSpace (FiniteMeasure Ω))
      ≤ borel (FiniteMeasure Ω) := by
  change ((⨆ (s : Set Ω) (_ : MeasurableSet s),
      (borel ℝ≥0∞).comap (fun μ : Measure Ω => μ s)).comap
        (Subtype.val : FiniteMeasure Ω → Measure Ω))
      ≤ borel (FiniteMeasure Ω)
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun s => ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun hs => ?_
  rw [MeasurableSpace.comap_comp]
  exact (borel_measurable_eval hs).comap_le

end

end FiniteMeasure

/-! ## Borel σ-algebra ≤ Giry σ-algebra (`ProbabilityMeasure`)

Under compactness, metrizability, second-countability, and Borel on `Ω`, the weak-* topology on
`ProbabilityMeasure Ω` is itself second-countable, so its Borel σ-algebra is generated by a
subbasis of the weak-* topology, every member of which is Giry-measurable. -/

namespace ProbabilityMeasure

section

open TopologicalSpace

variable {Ω : Type*} [MeasurableSpace Ω] [TopologicalSpace Ω] [BorelSpace Ω]
  [PseudoMetrizableSpace Ω] [SecondCountableTopology Ω]
  [CompactSpace Ω] [T2Space Ω]

omit [PseudoMetrizableSpace Ω] [SecondCountableTopology Ω] [CompactSpace Ω] [T2Space Ω] in
/-- The evaluation `μ ↦ μ.testAgainstNN f = (∫⁻ x, f x ∂μ).toNNReal` is Giry-measurable for each
`f : Ω →ᵇ ℝ≥0`. -/
private lemma measurable_giry_testAgainstNN (f : Ω →ᵇ ℝ≥0) :
    Measurable fun μ : ProbabilityMeasure Ω =>
      μ.toFiniteMeasure.testAgainstNN f := by
  have h_lint : Measurable fun ν : Measure Ω => ∫⁻ x, (f x : ℝ≥0∞) ∂ν :=
    Measure.measurable_lintegral f.continuous.measurable.coe_nnreal_ennreal
  have h_coeMeas : Measurable
      (fun μ : ProbabilityMeasure Ω => (μ : Measure Ω)) :=
    measurable_subtype_coe
  exact (h_lint.comp h_coeMeas).ennreal_toNNReal

omit [PseudoMetrizableSpace Ω] [SecondCountableTopology Ω] [CompactSpace Ω] [T2Space Ω] in
/-- The weak-* topology on `ProbabilityMeasure Ω` is induced from `Pi.topologicalSpace` on
`(Ω →ᵇ ℝ≥0) → ℝ≥0` via the evaluation map `μ f ↦ μ.testAgainstNN f`. -/
private lemma topology_eq_induced :
    (ProbabilityMeasure.instTopologicalSpace : TopologicalSpace (ProbabilityMeasure Ω)) =
      TopologicalSpace.induced
        (fun (μ : ProbabilityMeasure Ω) (f : Ω →ᵇ ℝ≥0) => μ.toFiniteMeasure.testAgainstNN f)
        Pi.topologicalSpace := by
  change TopologicalSpace.induced ProbabilityMeasure.toFiniteMeasure
      (TopologicalSpace.induced FiniteMeasure.toWeakDualBCNN
        (TopologicalSpace.induced (fun (x : WeakDual ℝ≥0 (Ω →ᵇ ℝ≥0)) y => x y)
          Pi.topologicalSpace)) = _
  rw [induced_compose, induced_compose]
  rfl

omit [SecondCountableTopology Ω] [CompactSpace Ω] [T2Space Ω] in
/-- The Giry σ-algebra on `ProbabilityMeasure Ω` is contained in the Borel σ-algebra of the weak-*
topology. -/
private lemma giry_le_borel_pm :
    (ProbabilityMeasure.instMeasurableSpace : MeasurableSpace (ProbabilityMeasure Ω))
      ≤ borel (ProbabilityMeasure Ω) := by
  letI : MeasurableSpace (ProbabilityMeasure Ω) := borel (ProbabilityMeasure Ω)
  haveI : BorelSpace (ProbabilityMeasure Ω) := ⟨rfl⟩
  change ((⨆ (s : Set Ω) (_ : MeasurableSet s),
      (borel ℝ≥0∞).comap (fun μ : Measure Ω => μ s)).comap
        ((↑) : ProbabilityMeasure Ω → Measure Ω))
      ≤ borel (ProbabilityMeasure Ω)
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun s => ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun hs => ?_
  rw [MeasurableSpace.comap_comp]
  -- `(fun μ ↦ (μ : Measure Ω) s) ∘ ((↑) : PM → Measure)` factors as
  -- `(fun μ ↦ (μ : Measure Ω) s on FM) ∘ toFiniteMeasure`.
  have h_eval_fm : @Measurable (FiniteMeasure Ω) ℝ≥0∞ (borel (FiniteMeasure Ω)) _
      (fun μ : FiniteMeasure Ω => (μ : Measure Ω) s) :=
    FiniteMeasure.borel_measurable_eval (Ω := Ω) hs
  have h_cont' : @Measurable _ _ (borel (ProbabilityMeasure Ω)) (borel (FiniteMeasure Ω))
      (ProbabilityMeasure.toFiniteMeasure : ProbabilityMeasure Ω → FiniteMeasure Ω) :=
    (ProbabilityMeasure.toFiniteMeasure_continuous (Ω := Ω)).borel_measurable
  -- `μ ↦ (μ : Measure Ω) s` on PM is defeq to the FM evaluation composed with `toFiniteMeasure`.
  have h_eval_pm : @Measurable _ _ (borel (ProbabilityMeasure Ω)) _
      (fun μ : ProbabilityMeasure Ω => (μ : Measure Ω) s) :=
    h_eval_fm.comp h_cont'
  exact h_eval_pm.comap_le

/-- The Borel σ-algebra of the weak-* topology on `ProbabilityMeasure Ω` is contained in the Giry
σ-algebra. -/
private lemma borel_le_giry :
    borel (ProbabilityMeasure Ω) ≤
      (ProbabilityMeasure.instMeasurableSpace : MeasurableSpace (ProbabilityMeasure Ω)) := by
  set evalFn : ProbabilityMeasure Ω → (Ω →ᵇ ℝ≥0) → ℝ≥0 :=
    fun μ f => μ.toFiniteMeasure.testAgainstNN f with hEvalFn
  -- Subbasis of the Pi topology: cylinders `(↑i).pi s`, `i` finite, `s a` open for `a ∈ i`.
  -- Subbasis of the PM topology: pullbacks of cylinders.
  set S : Set (Set (ProbabilityMeasure Ω)) := Set.image (Set.preimage evalFn)
      {g : Set ((Ω →ᵇ ℝ≥0) → ℝ≥0) |
        ∃ (s : (Ω →ᵇ ℝ≥0) → Set ℝ≥0) (i : Finset (Ω →ᵇ ℝ≥0)),
          (∀ a ∈ i, IsOpen (s a)) ∧ g = (↑i : Set (Ω →ᵇ ℝ≥0)).pi s} with hS
  have h_pi_top : (Pi.topologicalSpace : TopologicalSpace ((Ω →ᵇ ℝ≥0) → ℝ≥0)) =
      TopologicalSpace.generateFrom
        {g : Set ((Ω →ᵇ ℝ≥0) → ℝ≥0) |
          ∃ (s : (Ω →ᵇ ℝ≥0) → Set ℝ≥0) (i : Finset (Ω →ᵇ ℝ≥0)),
            (∀ a ∈ i, IsOpen (s a)) ∧ g = (↑i : Set (Ω →ᵇ ℝ≥0)).pi s} := pi_eq_generateFrom
  have h_top_pm :
      (ProbabilityMeasure.instTopologicalSpace : TopologicalSpace (ProbabilityMeasure Ω)) =
        TopologicalSpace.generateFrom S := by
    rw [topology_eq_induced, h_pi_top, induced_generateFrom_eq]
  have h_borel : borel (ProbabilityMeasure Ω) = MeasurableSpace.generateFrom S :=
    borel_eq_generateFrom_of_subbasis h_top_pm
  rw [h_borel]
  refine MeasurableSpace.generateFrom_le ?_
  rintro s ⟨_, ⟨w, I, hI_open, rfl⟩, rfl⟩
  -- `evalFn ⁻¹' ((↑I).pi w)` = `⋂ f ∈ I, {μ | μ.testAgainstNN f ∈ w f}`
  have h_eq : evalFn ⁻¹' ((↑I : Set (Ω →ᵇ ℝ≥0)).pi w) =
      ⋂ f ∈ I, {μ : ProbabilityMeasure Ω | μ.toFiniteMeasure.testAgainstNN f ∈ w f} := by
    ext μ
    simp only [hEvalFn, Set.mem_preimage, Set.mem_pi, Finset.mem_coe,
      Set.mem_iInter, Set.mem_setOf_eq]
  rw [h_eq]
  refine MeasurableSet.biInter I.countable_toSet ?_
  intro f hf
  exact measurable_giry_testAgainstNN f (hI_open f hf).measurableSet

end

end ProbabilityMeasure

section BorelInstances

variable {Ω : Type*} [MeasurableSpace Ω] [TopologicalSpace Ω] [BorelSpace Ω]
  [PseudoMetrizableSpace Ω] [SecondCountableTopology Ω] [CompactSpace Ω] [T2Space Ω]

/-- The weak-* topology and the Giry σ-algebra on `ProbabilityMeasure Ω` give a Borel space. -/
instance instBorelSpaceProbabilityMeasure : BorelSpace (ProbabilityMeasure Ω) :=
  ⟨le_antisymm (ProbabilityMeasure.giry_le_borel_pm)
    (ProbabilityMeasure.borel_le_giry)⟩

end BorelInstances

end MeasureTheory

/-- The wrapper `Econlib.Probability.ProbDist Ω = ProbabilityMeasure Ω` inherits the Borel space
structure. -/
instance Econlib.Probability.instBorelSpaceProbDist
    {Ω : Type*} [MeasurableSpace Ω] [TopologicalSpace Ω] [BorelSpace Ω]
    [PseudoMetrizableSpace Ω] [SecondCountableTopology Ω]
    [CompactSpace Ω] [T2Space Ω] :
    BorelSpace (Econlib.Probability.ProbDist Ω) :=
  inferInstanceAs (BorelSpace (MeasureTheory.ProbabilityMeasure Ω))
