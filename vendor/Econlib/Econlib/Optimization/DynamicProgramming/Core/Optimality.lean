public import Econlib.Optimization.DynamicProgramming.Core.Bellman

/-!
# Principle of optimality and value iteration

Plans and their feasibility for deterministic MDPs, the **principle of optimality** (the Bellman
fixed point equals the supremum of discounted payoffs over feasible plans), convergence of value
iteration to the value function, and the bridge between stationary policies and infinite plans. The
arguments rely on the discount factor `β < 1` together with bounded rewards, so that the discounted
tail vanishes.

## Main definitions

* `Plan`: An infinite sequence of actions, one per period.
* `discountedPayoff`: The discounted sum of rewards along a plan from a given state.
* `isFeasible`: A plan is feasible if every action lies in the feasible correspondence.
* `bellmanIterate`: Iterated application of the Bellman operator.

## Main statements

* `value_ge_payoff`: The Bellman fixed point dominates the discounted payoff of any feasible plan.
* `principle_of_optimality`: The value function equals the supremum of discounted payoffs over all
  feasible plans.
* `value_iteration_converges`: Value iteration converges to the value function in the sup norm.
* `stationary_plan_payoff_eq`: Telescoping payoff identity — if a stationary policy's action is
  Bellman-consistent with a candidate value at every state, the generated plan's discounted payoff
  equals that candidate value. (A payoff identity, not an optimality claim.)
* `stationary_policy_optimal`: A feasible stationary policy whose action attains the Bellman argmax
  against a bounded fixed point generates a feasible plan that attains the value and weakly
  dominates every feasible plan.
* `DetMDP.exists_optimalPolicy`: Under compactness and continuity, an optimal stationary policy
  function `σ : S → A` exists (selected from the pointwise optimizers) — feasible and weakly
  dominating every feasible plan.

## References

* Bellman, Richard. 1957. *Dynamic Programing*. Princeton University Press.
* Stokey, Nancy L., Robert E. Lucas, and Edward C. Prescott. 1989. *Recursive Methods in Economic
  Dynamics*. Harvard University Press. [https://doi.org/10.2307/j.ctvjnrt76](https://doi.org/10.2307/j.ctvjnrt76).

## Tags

dynamic programing, principle of optimality, value iteration, bellman equation, feasible plan,
discounted payoff
-/

@[expose] public section

namespace Econlib.Optimization.DynamicProgramming

open Blackwell Econlib.Optimization

universe u_S
variable {S : Type u_S} {A : Type*} [Nonempty S]

/-! ## Principle of Optimality -/

/-- A **plan** is an infinite sequence of actions, one per period. -/
def Plan (A : Type*) := ℕ → A

namespace UnboundedDetMDP

/-- The state sequence generated by a plan starting from state `s`. -/
noncomputable def stateSeq (M : UnboundedDetMDP S A) (s : S) (π : Plan A) (t : ℕ) : S :=
  Nat.recOn t s (fun t' s' ↦ M.transition s' (π t'))

/-- The discounted payoff of a plan starting from state `s`. -/
noncomputable def discountedPayoff (M : UnboundedDetMDP S A) (s : S) (π : Plan A) : ℝ :=
  ∑' t, M.β ^ t * M.reward (M.stateSeq s π t) (π t)

/-- A plan is **feasible** from state `s` if every action lies in the feasible set. -/
def isFeasible (M : UnboundedDetMDP S A) (s : S) (π : Plan A) : Prop :=
  ∀ t, π t ∈ M.Γ (M.stateSeq s π t)

/-- The state sequence starts at `s`. -/
@[simp] lemma stateSeq_zero (M : UnboundedDetMDP S A) (s : S) (π : Plan A) :
    M.stateSeq s π 0 = s := rfl

/-- The state at step `t + 1` is obtained by applying the transition at step `t`. -/
lemma stateSeq_succ (M : UnboundedDetMDP S A) (s : S) (π : Plan A) (t : ℕ) :
    M.stateSeq s π (t + 1) = M.transition (M.stateSeq s π t) (π t) := rfl

end UnboundedDetMDP

open UnboundedDetMDP

/-- Summability of the discounted reward stream (rewards bounded, β < 1). -/
lemma summable_discountedPayoff (M : DetMDP S A) (s : S) (π : Plan A) :
    Summable (fun t ↦ M.β ^ t * M.reward (M.stateSeq s π t) (π t)) := by
  obtain ⟨B, hB⟩ := M.reward_bounded
  apply Summable.of_norm_bounded (g := fun t ↦ M.β ^ t * B)
  · exact (summable_geometric_of_lt_one M.β_nonneg M.β_lt_one).mul_right B
  · intro t
    rw [Real.norm_eq_abs, abs_mul, abs_pow, abs_of_nonneg M.β_nonneg]
    exact mul_le_mul_of_nonneg_left (hB _ _) (pow_nonneg M.β_nonneg _)

/-- The geometric tail `β^N · c` vanishes (`β < 1`). -/
lemma tendsto_pow_beta_mul (M : DetMDP S A) (c : ℝ) :
    Filter.Tendsto (fun N ↦ M.β ^ N * c) Filter.atTop (nhds 0) := by
  rw [show (0 : ℝ) = 0 * c from (zero_mul _).symm]
  exact (tendsto_pow_atTop_nhds_zero_of_lt_one M.β_nonneg M.β_lt_one).mul_const _

/-- The discounted tail `β^N · g N` vanishes whenever `g` is bounded: Mathlib's
`bdd_le_mul_tendsto_zero'` with the bounded factor commuted to the right. -/
lemma tendsto_pow_beta_mul_bounded (M : DetMDP S A) (g : ℕ → ℝ) {B : ℝ}
    (hg : ∀ N, |g N| ≤ B) :
    Filter.Tendsto (fun N ↦ M.β ^ N * g N) Filter.atTop (nhds 0) := by
  simpa [mul_comm] using bdd_le_mul_tendsto_zero' B (.of_forall hg)
    (tendsto_pow_atTop_nhds_zero_of_lt_one M.β_nonneg M.β_lt_one)

/-- Build state-action pairs from a selection function `σ` and transition `f`. -/
noncomputable def buildSAPairs (σ : S → A) (f : S → A → S) (s₀ : S) : ℕ → S × A :=
  Nat.rec (s₀, σ s₀) (fun _ p => let s' := f p.1 p.2; (s', σ s'))

/-- The plan (action sequence) extracted from `buildSAPairs`. -/
noncomputable def extractPlan (σ : S → A) (f : S → A → S) (s₀ : S) (t : ℕ) : A :=
  (buildSAPairs σ f s₀ t).2

/-- The state sequence extracted from `buildSAPairs`. -/
noncomputable def extractState (σ : S → A) (f : S → A → S) (s₀ : S) (t : ℕ) : S :=
  (buildSAPairs σ f s₀ t).1

omit [Nonempty S] in
/-- The action at each step equals `σ` applied to the current state. -/
lemma extractPlan_eq_σ (σ : S → A) (f : S → A → S) (s₀ : S) (t : ℕ) :
    extractPlan σ f s₀ t = σ (extractState σ f s₀ t) := by
  cases t <;> rfl

omit [Nonempty S] in
/-- The extracted state sequence matches `stateSeq` with `π = extractPlan`. -/
lemma extractState_eq_stateSeq (σ : S → A) (f : S → A → S) (s₀ : S) (t : ℕ) :
    extractState σ f s₀ t =
      Nat.recOn t s₀ (fun t' s' => f s' (extractPlan σ f s₀ t')) := by
  induction t with
  | zero => rfl
  | succ n ih => exact congrArg (f · _) ih

namespace UnboundedDetMDP

/-- The trajectory of a greedily-extracted plan matches the carrier-independent `extractState`. -/
lemma stateSeq_eq_extractState (M : UnboundedDetMDP S A) (σ : S → A) (s : S) (t : ℕ) :
    M.stateSeq s (extractPlan σ M.transition s) t = extractState σ M.transition s t :=
  (extractState_eq_stateSeq σ M.transition s t).symm

/-- Given `Γ_nonempty`, there exists a feasible plan from any initial state. -/
lemma exists_feasible_plan (M : UnboundedDetMDP S A) (s : S) : ∃ π : Plan A, M.isFeasible s π := by
  have hσ : ∀ s' : S, ∃ a, a ∈ M.Γ s' := M.Γ_nonempty
  set σ := fun s' => (hσ s').choose
  have hσ_mem : ∀ s', σ s' ∈ M.Γ s' := fun s' => (hσ s').choose_spec
  refine ⟨extractPlan σ M.transition s, fun t => ?_⟩
  rw [extractPlan_eq_σ, M.stateSeq_eq_extractState]
  exact hσ_mem _

end UnboundedDetMDP

/-- Telescoping: `v*(s₀) ≥ Σ_{t=0}^{N} β^t r_t + β^{N+1} v*(s_{N+1})` for any feasible plan, by
iterating the Bellman inequality `v*(s) ≥ r(s,a) + β v*(s')`. -/
lemma value_ge_partialPayoff_add_tail (M : DetMDP S A)
    (v_star : S → ℝ) (hv : ∀ s, v_star s = M.bellmanOperator v_star s)
    (hv_bdd : UniformBounded v_star)
    (s : S) (π : Plan A) (hπ : M.isFeasible s π) (N : ℕ) :
    v_star s ≥ ∑ t ∈ Finset.range N,
        M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
      M.β ^ N * v_star (M.stateSeq s π N) := by
  induction N with
  | zero => simp [stateSeq]
  | succ n ih =>
    have hstep : v_star (M.stateSeq s π n) ≥
        M.reward (M.stateSeq s π n) (π n) +
        M.β * v_star (M.stateSeq s π (n + 1)) := by
      rw [hv (M.stateSeq s π n)]
      unfold bellmanOperator
      apply le_csSup (bellmanSet_bddAbove M v_star hv_bdd _)
      exact ⟨π n, hπ n, by simp [stateSeq]⟩
    have hmul : M.β ^ n * v_star (M.stateSeq s π n) ≥
        M.β ^ n * M.reward (M.stateSeq s π n) (π n) +
        M.β ^ (n + 1) * v_star (M.stateSeq s π (n + 1)) := by
      have hβn : (0 : ℝ) ≤ M.β ^ n := pow_nonneg M.β_nonneg n
      calc M.β ^ n * v_star (M.stateSeq s π n)
          ≥ M.β ^ n * (M.reward (M.stateSeq s π n) (π n) +
              M.β * v_star (M.stateSeq s π (n + 1))) := mul_le_mul_of_nonneg_left hstep hβn
        _ = M.β ^ n * M.reward (M.stateSeq s π n) (π n) +
              M.β ^ (n + 1) * v_star (M.stateSeq s π (n + 1)) := by ring
    calc v_star s ≥ ∑ t ∈ Finset.range n,
            M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
          M.β ^ n * v_star (M.stateSeq s π n) := ih
      _ ≥ ∑ t ∈ Finset.range n,
            M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
          (M.β ^ n * M.reward (M.stateSeq s π n) (π n) +
           M.β ^ (n + 1) * v_star (M.stateSeq s π (n + 1))) := by linarith
      _ = (∑ t ∈ Finset.range n,
            M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
          M.β ^ n * M.reward (M.stateSeq s π n) (π n)) +
          M.β ^ (n + 1) * v_star (M.stateSeq s π (n + 1)) := by ring
      _ = ∑ t ∈ Finset.range (n + 1),
            M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
          M.β ^ (n + 1) * v_star (M.stateSeq s π (n + 1)) := by
        congr 1; rw [Finset.sum_range_succ]

/-- **Principle of Optimality (≥ direction)**: The Bellman fixed point `v*` dominates the
discounted payoff of any feasible plan. -/
theorem value_ge_payoff (M : DetMDP S A)
    (v_star : S → ℝ) (hv : ∀ s, v_star s = M.bellmanOperator v_star s)
    (hv_bdd : UniformBounded v_star)
    (s : S) (π : Plan A) (hπ : M.isFeasible s π) :
    M.discountedPayoff s π ≤ v_star s := by
  obtain ⟨Bv, hBv⟩ := hv_bdd
  have hsumm := summable_discountedPayoff M s π
  suffices h : ∀ N, ∑ t ∈ Finset.range N,
      M.β ^ t * M.reward (M.stateSeq s π t) (π t) ≤ v_star s +
      M.β ^ N * Bv by
    have hpartial : Filter.Tendsto
        (fun N ↦ ∑ t ∈ Finset.range N,
          M.β ^ t * M.reward (M.stateSeq s π t) (π t))
        Filter.atTop (nhds (M.discountedPayoff s π)) := by
      unfold discountedPayoff
      exact hsumm.hasSum.tendsto_sum_nat
    have htail : Filter.Tendsto (fun N ↦ M.β ^ N * Bv)
        Filter.atTop (nhds 0) := tendsto_pow_beta_mul M Bv
    have hlim := Filter.Tendsto.add (tendsto_const_nhds (x := v_star s)) htail
    rw [add_zero] at hlim
    exact le_of_tendsto_of_tendsto hpartial hlim (.of_forall h)
  intro N
  have htel := value_ge_partialPayoff_add_tail M v_star hv ⟨Bv, hBv⟩ s π hπ N
  have hv_bound : -(M.β ^ N * Bv) ≤ M.β ^ N * v_star (M.stateSeq s π N) := by
    have hβN : (0 : ℝ) ≤ M.β ^ N := pow_nonneg M.β_nonneg N
    nlinarith [neg_abs_le (v_star (M.stateSeq s π N)), hBv (M.stateSeq s π N)]
  linarith

/-- **Principle of optimality** (Bellman 1957): The value function `v*` satisfying `v* = Tv*`
equals the supremum of discounted payoffs over all feasible plans.

The supremum is taken as `sSup` over a set rather than a conditional `iSup`, since over a
`ConditionallyCompleteLinearOrder` an empty `iSup` silently returns `0` and would corrupt the
statement when `v*(s) < 0`. -/
theorem principle_of_optimality (M : DetMDP S A)
    (v_star : S → ℝ) (hv : ∀ s, v_star s = M.bellmanOperator v_star s)
    (hv_bdd : UniformBounded v_star) :
    ∀ s, v_star s = sSup {p : ℝ | ∃ π : Plan A, M.isFeasible s π ∧
      p = M.discountedPayoff s π} := by
  intro s
  apply le_antisymm
  · -- For all ε > 0, construct an ε-optimal plan whose payoff ≥ v*(s) - ε.
    set PayoffSet := {p : ℝ | ∃ π : Plan A, M.isFeasible s π ∧ p = M.discountedPayoff s π}
    have hS_ne : PayoffSet.Nonempty := by
      obtain ⟨π₀, hπ₀⟩ := M.exists_feasible_plan s
      exact ⟨M.discountedPayoff s π₀, π₀, hπ₀, rfl⟩
    have hS_bdd : BddAbove PayoffSet :=
      ⟨v_star s, fun p hp => by obtain ⟨π, hπ, rfl⟩ := hp
                                exact value_ge_payoff M v_star hv hv_bdd s π hπ⟩
    apply le_of_forall_pos_lt_add
    intro ε hε
    have hβ_lt : M.β < 1 := M.β_lt_one
    have hone_sub_β_pos : 0 < 1 - M.β := by linarith
    set δ := ε * (1 - M.β) / 2 with hδ_def
    have hδ : 0 < δ := by positivity
    have h_near_opt : ∀ s' : S, ∃ a ∈ M.Γ s',
        v_star s' - δ < M.reward s' a + M.β * v_star (M.transition s' a) := by
      intro s'
      rw [hv s']
      unfold bellmanOperator
      have hne := M.bellmanSet_nonempty v_star s'
      -- The supremum is not attained at `δ` below itself, so some feasible action beats it.
      obtain ⟨r, ⟨a, ha, rfl⟩, hlt⟩ := exists_lt_of_lt_csSup hne (sub_lt_self _ hδ)
      exact ⟨a, ha, hlt⟩
    choose σ hσ_mem hσ_near using h_near_opt
    set π_ε := extractPlan σ M.transition s
    have hπ_feas : M.isFeasible s π_ε := by
      intro t
      change extractPlan σ M.transition s t ∈ M.Γ (M.stateSeq s (extractPlan σ M.transition s) t)
      rw [extractPlan_eq_σ, extractState_eq_stateSeq]
      exact hσ_mem _
    have h_step_le : ∀ t : ℕ,
        v_star (M.stateSeq s π_ε t) ≤
          M.reward (M.stateSeq s π_ε t) (π_ε t) +
          M.β * v_star (M.stateSeq s π_ε (t + 1)) + δ := by
      intro t
      have hact : π_ε t = σ (M.stateSeq s π_ε t) := by
        change extractPlan σ M.transition s t = σ (M.stateSeq s (extractPlan σ M.transition s) t)
        rw [extractPlan_eq_σ]; congr 1
        exact extractState_eq_stateSeq σ M.transition s t
      have hσ_near_step := hσ_near (M.stateSeq s π_ε t)
      have htrans : M.transition (M.stateSeq s π_ε t) (π_ε t) =
          M.stateSeq s π_ε (t + 1) := by simp [stateSeq]
      rw [← hact] at hσ_near_step; rw [htrans] at hσ_near_step
      linarith
    have h_rev_tel : ∀ N : ℕ,
        v_star s ≤ ∑ t ∈ Finset.range N,
            M.β ^ t * M.reward (M.stateSeq s π_ε t) (π_ε t) +
          M.β ^ N * v_star (M.stateSeq s π_ε N) +
          δ * ∑ t ∈ Finset.range N, M.β ^ t := by
      intro N
      induction N with
      | zero => simp [stateSeq]
      | succ n ih =>
        have hβn : (0 : ℝ) ≤ M.β ^ n := pow_nonneg M.β_nonneg n
        have hmul : M.β ^ n * v_star (M.stateSeq s π_ε n) ≤
            M.β ^ n * M.reward (M.stateSeq s π_ε n) (π_ε n) +
            M.β ^ (n + 1) * v_star (M.stateSeq s π_ε (n + 1)) +
            M.β ^ n * δ := by
          have := h_step_le n
          calc M.β ^ n * v_star (M.stateSeq s π_ε n)
              ≤ M.β ^ n * (M.reward (M.stateSeq s π_ε n) (π_ε n) +
                  M.β * v_star (M.stateSeq s π_ε (n + 1)) + δ) :=
                mul_le_mul_of_nonneg_left this hβn
            _ = M.β ^ n * M.reward (M.stateSeq s π_ε n) (π_ε n) +
                M.β ^ (n + 1) * v_star (M.stateSeq s π_ε (n + 1)) +
                M.β ^ n * δ := by ring
        calc v_star s
            ≤ ∑ t ∈ Finset.range n,
                M.β ^ t * M.reward (M.stateSeq s π_ε t) (π_ε t) +
              M.β ^ n * v_star (M.stateSeq s π_ε n) +
              δ * ∑ t ∈ Finset.range n, M.β ^ t := ih
          _ ≤ ∑ t ∈ Finset.range n,
                M.β ^ t * M.reward (M.stateSeq s π_ε t) (π_ε t) +
              (M.β ^ n * M.reward (M.stateSeq s π_ε n) (π_ε n) +
               M.β ^ (n + 1) * v_star (M.stateSeq s π_ε (n + 1)) +
               M.β ^ n * δ) +
              δ * ∑ t ∈ Finset.range n, M.β ^ t := by linarith
          _ = (∑ t ∈ Finset.range n,
                M.β ^ t * M.reward (M.stateSeq s π_ε t) (π_ε t) +
              M.β ^ n * M.reward (M.stateSeq s π_ε n) (π_ε n)) +
              M.β ^ (n + 1) * v_star (M.stateSeq s π_ε (n + 1)) +
              δ * (∑ t ∈ Finset.range n, M.β ^ t + M.β ^ n) := by ring
          _ = ∑ t ∈ Finset.range (n + 1),
                M.β ^ t * M.reward (M.stateSeq s π_ε t) (π_ε t) +
              M.β ^ (n + 1) * v_star (M.stateSeq s π_ε (n + 1)) +
              δ * ∑ t ∈ Finset.range (n + 1), M.β ^ t := by
            congr 1
            · rw [Finset.sum_range_succ]
            · rw [Finset.sum_range_succ]
    obtain ⟨Bv, hBv⟩ := hv_bdd
    have hpartial : Filter.Tendsto
        (fun N ↦ ∑ t ∈ Finset.range N,
          M.β ^ t * M.reward (M.stateSeq s π_ε t) (π_ε t))
        Filter.atTop (nhds (M.discountedPayoff s π_ε)) := by
      unfold discountedPayoff
      exact (summable_discountedPayoff M s π_ε).hasSum.tendsto_sum_nat
    have htail : Filter.Tendsto (fun N ↦ M.β ^ N * v_star (M.stateSeq s π_ε N))
        Filter.atTop (nhds 0) := tendsto_pow_beta_mul_bounded M _ fun N => hBv (M.stateSeq s π_ε N)
    have hgeom : Filter.Tendsto (fun N ↦ δ * ∑ t ∈ Finset.range N, M.β ^ t)
        Filter.atTop (nhds (δ * (1 - M.β)⁻¹)) :=
      Filter.Tendsto.const_mul δ (hasSum_geometric_of_lt_one M.β_nonneg M.β_lt_one).tendsto_sum_nat
    have hlim : Filter.Tendsto
        (fun N ↦ ∑ t ∈ Finset.range N,
            M.β ^ t * M.reward (M.stateSeq s π_ε t) (π_ε t) +
          M.β ^ N * v_star (M.stateSeq s π_ε N) +
          δ * ∑ t ∈ Finset.range N, M.β ^ t)
        Filter.atTop (nhds (M.discountedPayoff s π_ε + 0 + δ * (1 - M.β)⁻¹)) :=
      (hpartial.add htail).add hgeom
    rw [add_zero] at hlim
    have hv_le : v_star s ≤ M.discountedPayoff s π_ε + δ * (1 - M.β)⁻¹ :=
      le_of_tendsto_of_tendsto tendsto_const_nhds hlim (.of_forall h_rev_tel)
    have hpay_le : M.discountedPayoff s π_ε ≤ sSup PayoffSet :=
      le_csSup hS_bdd ⟨π_ε, hπ_feas, rfl⟩
    have hδ_bound : δ * (1 - M.β)⁻¹ < ε := by
      have hδ_eq : δ * (1 - M.β)⁻¹ = ε / 2 := by rw [hδ_def]; field_simp
      rw [hδ_eq]
      linarith
    linarith
  · apply csSup_le
    · obtain ⟨π₀, hπ₀⟩ := M.exists_feasible_plan s
      exact ⟨M.discountedPayoff s π₀, π₀, hπ₀, rfl⟩
    · rintro p ⟨π, hπ, rfl⟩
      exact value_ge_payoff M v_star hv hv_bdd s π hπ

/-! ## Value Iteration Convergence -/

/-- Iterated application of the Bellman operator. -/
noncomputable def bellmanIterate (M : DetMDP S A) (v₀ : S → ℝ) : ℕ → S → ℝ
  | 0 => v₀
  | n + 1 => M.bellmanOperator (bellmanIterate M v₀ n)

/-- **Value iteration convergence**: Starting from any bounded initial guess, repeated application
of `T` converges to `v*` in the sup norm. -/
theorem value_iteration_converges (M : DetMDP S A)
    (v₀ : S → ℝ) (hv₀ : UniformBounded v₀)
    (v_star : S → ℝ) (hv : ∀ s, v_star s = M.bellmanOperator v_star s)
    (hv_bdd : UniformBounded v_star) :
    Filter.Tendsto (fun n ↦ ⨆ s, |bellmanIterate M v₀ n s - v_star s|)
      Filter.atTop (nhds 0) := by
  have hiter_bdd : ∀ n, ∃ B : ℝ, ∀ s, |bellmanIterate M v₀ n s| ≤ B := by
    intro n; induction n with
    | zero => exact hv₀
    | succ n ih => exact bellmanOperator_bounded M _ ih
  have hcontract : ∀ n, ⨆ s, |bellmanIterate M v₀ n s - v_star s| ≤
      M.β ^ n * ⨆ s, |v₀ s - v_star s| := by
    intro n; induction n with
    | zero => simp [bellmanIterate]
    | succ n ih =>
      have hrewrite : ∀ s, bellmanIterate M v₀ (n + 1) s - v_star s =
          M.bellmanOperator (bellmanIterate M v₀ n) s - M.bellmanOperator v_star s := by
        intro s; simp only [bellmanIterate]; congr 1; exact hv s
      calc ⨆ s, |bellmanIterate M v₀ (n + 1) s - v_star s|
          = ⨆ s, |M.bellmanOperator (bellmanIterate M v₀ n) s - M.bellmanOperator v_star s| := by
            congr 1; ext s; rw [hrewrite]
        _ ≤ M.β * ⨆ s, |bellmanIterate M v₀ n s - v_star s| :=
            bellmanOperator_contraction M _ _ (hiter_bdd n) hv_bdd
        _ ≤ M.β * (M.β ^ n * ⨆ s, |v₀ s - v_star s|) :=
            mul_le_mul_of_nonneg_left ih M.β_nonneg
        _ = M.β ^ (n + 1) * ⨆ s, |v₀ s - v_star s| := by ring
  have htend : Filter.Tendsto (fun n => M.β ^ n * ⨆ s, |v₀ s - v_star s|)
      Filter.atTop (nhds 0) := tendsto_pow_beta_mul M _
  apply squeeze_zero_norm' (.of_forall fun n => ?_) htend
  set sup_n := ⨆ s, |bellmanIterate M v₀ n s - v_star s| with hsup_def
  calc |sup_n| = sup_n :=
        abs_of_nonneg (le_ciSup_of_le (bddAbove_range_abs_sub _ _ (hiter_bdd n) hv_bdd)
          (Classical.arbitrary S) (abs_nonneg _))
    _ ≤ M.β ^ n * ⨆ s, |v₀ s - v_star s| := hcontract n

/-! ## Policy/Plan Bridge -/

/-- A stationary selection function generates a feasible plan. -/
lemma stationary_plan_feasible {M : DetMDP S A} (σ : S → A) (hσ : ∀ s, σ s ∈ M.Γ s) (s : S) :
    M.isFeasible s (extractPlan σ M.transition s) := by
  intro t
  rw [extractPlan_eq_σ, extractState_eq_stateSeq]
  exact hσ _

/-- **Telescoping payoff identity.** If a stationary policy's action is *Bellman-consistent* with a
candidate value `v_star` at every state —
`v_star s = reward s (σ s) + β · v_star (transition s (σ s))` — then the discounted payoff of the
generated plan equals `v_star s`.

This is the telescoping of the consistency equation: It does not require `σ s ∈ M.Γ s`
(feasibility) or that `σ` attain the Bellman argmax, and it asserts nothing about optimality. For
the optimality statement — feasibility plus weak dominance over every feasible plan — see
`stationary_policy_optimal`. -/
theorem stationary_plan_payoff_eq {M : DetMDP S A}
    (v_star : S → ℝ)
    (hv_bdd : UniformBounded v_star)
    (σ : S → A)
    (hσ_opt : ∀ s, v_star s = M.reward s (σ s) + M.β * v_star (M.transition s (σ s)))
    (s : S) :
    M.discountedPayoff s (extractPlan σ M.transition s) = v_star s := by
  set π := extractPlan σ M.transition s
  have h_tel_eq : ∀ N : ℕ,
      v_star s = ∑ t ∈ Finset.range N,
          M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
        M.β ^ N * v_star (M.stateSeq s π N) := by
    intro N
    induction N with
    | zero => simp [stateSeq]
    | succ n ih =>
      have hact : π n = σ (M.stateSeq s π n) := by
        change extractPlan σ M.transition s n = σ (M.stateSeq s (extractPlan σ M.transition s) n)
        rw [extractPlan_eq_σ]; congr 1
        exact extractState_eq_stateSeq σ M.transition s n
      have htrans : M.transition (M.stateSeq s π n) (π n) =
          M.stateSeq s π (n + 1) := by simp [stateSeq]
      have hstep : v_star (M.stateSeq s π n) =
          M.reward (M.stateSeq s π n) (π n) +
          M.β * v_star (M.stateSeq s π (n + 1)) := by
        have hopt := hσ_opt (M.stateSeq s π n)
        rw [← hact] at hopt; rw [htrans] at hopt; exact hopt
      calc v_star s
          = ∑ t ∈ Finset.range n,
              M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
            M.β ^ n * v_star (M.stateSeq s π n) := ih
        _ = ∑ t ∈ Finset.range n,
              M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
            M.β ^ n * (M.reward (M.stateSeq s π n) (π n) +
              M.β * v_star (M.stateSeq s π (n + 1))) := by rw [hstep]
        _ = (∑ t ∈ Finset.range n,
              M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
            M.β ^ n * M.reward (M.stateSeq s π n) (π n)) +
            M.β ^ (n + 1) * v_star (M.stateSeq s π (n + 1)) := by ring
        _ = ∑ t ∈ Finset.range (n + 1),
              M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
            M.β ^ (n + 1) * v_star (M.stateSeq s π (n + 1)) := by
          congr 1; rw [Finset.sum_range_succ]
  have hpartial : Filter.Tendsto
      (fun N ↦ ∑ t ∈ Finset.range N,
        M.β ^ t * M.reward (M.stateSeq s π t) (π t))
      Filter.atTop (nhds (M.discountedPayoff s π)) := by
    unfold discountedPayoff
    exact (summable_discountedPayoff M s π).hasSum.tendsto_sum_nat
  obtain ⟨Bv, hBv⟩ := hv_bdd
  have htail : Filter.Tendsto (fun N ↦ M.β ^ N * v_star (M.stateSeq s π N))
      Filter.atTop (nhds 0) :=
    tendsto_pow_beta_mul_bounded M _ fun N => hBv (M.stateSeq s π N)
  have hlim : Filter.Tendsto
      (fun N ↦ ∑ t ∈ Finset.range N,
          M.β ^ t * M.reward (M.stateSeq s π t) (π t) +
        M.β ^ N * v_star (M.stateSeq s π N))
      Filter.atTop (nhds (M.discountedPayoff s π + 0)) :=
    hpartial.add htail
  rw [add_zero] at hlim
  have hconst : Filter.Tendsto (fun _ : ℕ ↦ v_star s)
      Filter.atTop (nhds (v_star s)) := tendsto_const_nhds
  exact (tendsto_nhds_unique (hconst.congr (fun N => h_tel_eq N)) hlim).symm

/-- **Stationary policy optimality.** Suppose `v_star` is a bounded Bellman fixed point and `σ` is
a feasible stationary policy (`σ s ∈ M.Γ s`) whose action attains the Bellman argmax against
`v_star` at every state — `v_star s = reward s (σ s) + β · v_star (transition s (σ s))`, which
given the fixed-point property says `σ s` realizes the supremum defining `(T v_star) s`. Then the
generated plan is feasible, its discounted payoff equals `v_star s`, and it weakly dominates the
discounted payoff of every feasible plan. -/
theorem stationary_policy_optimal {M : DetMDP S A}
    (v_star : S → ℝ)
    (hv : ∀ s, v_star s = M.bellmanOperator v_star s)
    (hv_bdd : UniformBounded v_star)
    (σ : S → A)
    (hσ_mem : ∀ s, σ s ∈ M.Γ s)
    (hσ_opt : ∀ s, v_star s = M.reward s (σ s) + M.β * v_star (M.transition s (σ s)))
    (s : S) :
    M.isFeasible s (extractPlan σ M.transition s) ∧
      M.discountedPayoff s (extractPlan σ M.transition s) = v_star s ∧
      ∀ π : Plan A, M.isFeasible s π →
        M.discountedPayoff s π ≤ M.discountedPayoff s (extractPlan σ M.transition s) := by
  have hpayoff : M.discountedPayoff s (extractPlan σ M.transition s) = v_star s :=
    stationary_plan_payoff_eq v_star hv_bdd σ hσ_opt s
  refine ⟨stationary_plan_feasible σ hσ_mem s, hpayoff, fun π hπ => ?_⟩
  rw [hpayoff]
  exact value_ge_payoff M v_star hv hv_bdd s π hπ

/-! ## Corollaries at the canonical value function

The optimality theorems above are stated for an arbitrary bounded Bellman fixed point `v_star`.
The following corollaries specialize each theorem to the canonical fixed point `M.valueFunction`,
using `M.valueFunction_isFixedPt` and `M.valueFunction_bounded`. -/

/-- **`value_ge_payoff` at the value function.** The value function dominates the discounted payoff
of any feasible plan. -/
theorem DetMDP.valueFunction_ge_payoff (M : DetMDP S A) (s : S) (π : Plan A)
    (hπ : M.isFeasible s π) :
    M.discountedPayoff s π ≤ M.valueFunction s :=
  value_ge_payoff M M.valueFunction M.valueFunction_isFixedPt M.valueFunction_bounded s π hπ

/-- **Principle of optimality at the value function.** The value function equals the supremum of
discounted payoffs over all feasible plans. -/
theorem DetMDP.valueFunction_eq_sup_payoff (M : DetMDP S A) (s : S) :
    M.valueFunction s = sSup {p : ℝ | ∃ π : Plan A, M.isFeasible s π ∧
      p = M.discountedPayoff s π} :=
  principle_of_optimality M M.valueFunction M.valueFunction_isFixedPt M.valueFunction_bounded s

/-- **Value iteration converges to the value function.** From any bounded initial guess `v₀`, the
Bellman iterates approach `M.valueFunction` in the sup norm. -/
theorem DetMDP.value_iteration_converges_to_valueFunction (M : DetMDP S A)
    (v₀ : S → ℝ) (hv₀ : UniformBounded v₀) :
    Filter.Tendsto (fun n ↦ ⨆ s, |bellmanIterate M v₀ n s - M.valueFunction s|)
      Filter.atTop (nhds 0) :=
  value_iteration_converges M v₀ hv₀ M.valueFunction M.valueFunction_isFixedPt
    M.valueFunction_bounded

/-- **Payoff identity at the value function.** If a stationary policy's action is
Bellman-consistent with `M.valueFunction` at every state, the generated plan's discounted payoff
equals `M.valueFunction`. A payoff identity, not an optimality claim — feasibility is not required;
for optimality see `DetMDP.stationary_policy_optimal_valueFunction`. -/
theorem DetMDP.stationary_plan_payoff_eq_valueFunction (M : DetMDP S A)
    (σ : S → A)
    (hσ_opt : ∀ s, M.valueFunction s =
      M.reward s (σ s) + M.β * M.valueFunction (M.transition s (σ s)))
    (s : S) :
    M.discountedPayoff s (extractPlan σ M.transition s) = M.valueFunction s :=
  stationary_plan_payoff_eq M.valueFunction M.valueFunction_bounded σ hσ_opt s

/-- **Stationary policy optimality at the value function.** A feasible stationary policy
(`σ s ∈ M.Γ s`) whose action attains the Bellman argmax against `M.valueFunction` at every state
generates a feasible plan that attains `M.valueFunction` and weakly dominates the discounted payoff
of every feasible plan. -/
theorem DetMDP.stationary_policy_optimal_valueFunction (M : DetMDP S A)
    (σ : S → A)
    (hσ_mem : ∀ s, σ s ∈ M.Γ s)
    (hσ_opt : ∀ s, M.valueFunction s =
      M.reward s (σ s) + M.β * M.valueFunction (M.transition s (σ s)))
    (s : S) :
    M.isFeasible s (extractPlan σ M.transition s) ∧
      M.discountedPayoff s (extractPlan σ M.transition s) = M.valueFunction s ∧
      ∀ π : Plan A, M.isFeasible s π →
        M.discountedPayoff s π ≤ M.discountedPayoff s (extractPlan σ M.transition s) :=
  stationary_policy_optimal M.valueFunction M.valueFunction_isFixedPt M.valueFunction_bounded
    σ hσ_mem hσ_opt s

/-! ## Existence of an optimal stationary policy function

`DetMDP.exists_optimalAction` (`Bellman.lean`) gives a pointwise `∀ s, ∃ a …` statement, not a
policy function `S → A`. The theorems below select a single stationary policy and combine it with
`stationary_policy_optimal` to certify feasibility plus weak dominance over every feasible plan. -/

/-- **Existence of an optimal stationary policy.** Suppose `Γ(s)` is compact, the reward and
transition are continuous, and `v_star` is a bounded continuous Bellman fixed point. Then there
exists a stationary policy *function* `σ : S → A` that is feasible (`σ s ∈ Γ s`) and, from every
state, generates a feasible plan whose discounted payoff equals `v_star` and weakly dominates the
discounted payoff of every feasible plan.

Continuity of `v_star` is needed for compactness to deliver an attained maximizer at each state;
boundedness is needed for the dominance argument (telescoping tail vanishes). -/
theorem DetMDP.exists_optimalPolicy [TopologicalSpace A] [TopologicalSpace S]
    (M : DetMDP S A)
    (h_compact : ∀ s, IsCompact (M.Γ s))
    (h_cont_reward : ∀ s, ContinuousOn (M.reward s) (M.Γ s))
    (h_cont_trans : ∀ s, ContinuousOn (M.transition s) (M.Γ s))
    (v_star : S → ℝ) (hv : ∀ s, v_star s = M.bellmanOperator v_star s)
    (hv_bdd : UniformBounded v_star) (h_v_cont : Continuous v_star) :
    ∃ σ : S → A, (∀ s, σ s ∈ M.Γ s) ∧
      ∀ s, M.isFeasible s (extractPlan σ M.transition s) ∧
        M.discountedPayoff s (extractPlan σ M.transition s) = v_star s ∧
        ∀ π : Plan A, M.isFeasible s π →
          M.discountedPayoff s π ≤ M.discountedPayoff s (extractPlan σ M.transition s) := by
  choose σ hσ_mem hσ_opt using
    M.exists_optimalAction h_compact h_cont_reward h_cont_trans v_star hv h_v_cont
  exact ⟨σ, hσ_mem, fun s => stationary_policy_optimal v_star hv hv_bdd σ hσ_mem hσ_opt s⟩

/-- **Existence of an optimal stationary policy at the value function.** The value function is
bounded for free (`M.valueFunction_bounded`), so the only extra hypothesis beyond compactness and
continuity of the primitives is continuity of `M.valueFunction` itself. Under it, an optimal
stationary policy function attaining `M.valueFunction` exists. -/
theorem DetMDP.exists_optimalPolicy_valueFunction [TopologicalSpace A] [TopologicalSpace S]
    (M : DetMDP S A)
    (h_compact : ∀ s, IsCompact (M.Γ s))
    (h_cont_reward : ∀ s, ContinuousOn (M.reward s) (M.Γ s))
    (h_cont_trans : ∀ s, ContinuousOn (M.transition s) (M.Γ s))
    (h_v_cont : Continuous M.valueFunction) :
    ∃ σ : S → A, (∀ s, σ s ∈ M.Γ s) ∧
      ∀ s, M.isFeasible s (extractPlan σ M.transition s) ∧
        M.discountedPayoff s (extractPlan σ M.transition s) = M.valueFunction s ∧
        ∀ π : Plan A, M.isFeasible s π →
          M.discountedPayoff s π ≤ M.discountedPayoff s (extractPlan σ M.transition s) :=
  M.exists_optimalPolicy h_compact h_cont_reward h_cont_trans M.valueFunction
    M.valueFunction_isFixedPt M.valueFunction_bounded h_v_cont

end Econlib.Optimization.DynamicProgramming
