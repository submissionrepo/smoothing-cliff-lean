module

public import Econlib.Optimization.OptimalTransport.Atomization
public import Econlib.Optimization.OptimalTransport.KRSignedMeasure

/-!
# Density of the point-mass span in the Kantorovich–Rubinstein norm

For a compact metric space `Ω`, the linear span of signed point masses `{ofPointMass ω : ω : Ω}` is
dense in `KRSignedMeasure Ω` with respect to the Kantorovich–Rubinstein norm. This is the
analytical engine behind Hanin's representation theorem.

## Main definitions

* `KRSignedMeasure.ofPointMass` — the signed point mass at a point.
* `KRSignedMeasure.pointMassSpan` — the `ℝ`-submodule generated by `ofPointMass`.

## Main statements

* `KRSignedMeasure.exists_pointMass_approx` — every signed measure is approximated in KR norm to
  arbitrary precision by a finite signed combination of point masses.
* `KRSignedMeasure.pointMassSpan_dense` — `pointMassSpan` is dense in the KR norm.
* `KRSignedMeasure.eq_zero_of_vanishes_on_pointMass` — a continuous linear functional that vanishes
  on every point mass is identically zero.

## Tags

atomic measure, point mass, kantorovich-rubinstein, density, signed measure
-/

@[expose] public section

namespace Econlib.Optimization.OptimalTransport

namespace KRSignedMeasure

open MeasureTheory Set
open Econlib.Probability Econlib.Probability.ProbDist
open scoped BoundedContinuousFunction

variable {Ω : Type*} [PseudoMetricSpace Ω] [MeasurableSpace Ω] [BorelSpace Ω]
  [CompactSpace Ω] [Inhabited Ω]

/-! ### The point-mass embedding -/

/-- Embedding of a point as a signed point mass. -/
noncomputable def ofPointMass (ω : Ω) : KRSignedMeasure Ω where
  toSignedMeasure := (MeasureTheory.Measure.dirac ω).toSignedMeasure

omit [PseudoMetricSpace Ω] [BorelSpace Ω] [CompactSpace Ω] [Inhabited Ω] in
/-- The total mass of a signed point mass is `1`. -/
@[simp] lemma toSignedMeasure_ofPointMass_univ (ω : Ω) :
    ((ofPointMass ω : KRSignedMeasure Ω).toSignedMeasure Set.univ : ℝ) = 1 := by
  change (((MeasureTheory.Measure.dirac ω).toSignedMeasure) Set.univ : ℝ) = 1
  rw [MeasureTheory.Measure.toSignedMeasure_apply_measurable MeasurableSet.univ,
    MeasureTheory.probReal_univ]

omit [CompactSpace Ω] [Inhabited Ω] in
/-- The signed integral of a Lipschitz `p` against a point mass is `p ω`. -/
lemma signedIntegral_ofPointMass {p : Ω → ℝ} (hp : LipschitzWith 1 p) (ω : Ω) :
    (∫ x, p x
        ∂(ofPointMass ω : KRSignedMeasure Ω).toSignedMeasure.toJordanDecomposition.posPart)
      - (∫ x, p x
        ∂(ofPointMass ω : KRSignedMeasure Ω).toSignedMeasure.toJordanDecomposition.negPart)
    = p ω := by
  have hJ := signedIntegral_of_measure (MeasureTheory.Measure.dirac ω) p
  -- `(ofPointMass ω).toSignedMeasure = (Measure.dirac ω).toSignedMeasure` by definition.
  change
      (∫ x, p x
        ∂(MeasureTheory.Measure.dirac ω).toSignedMeasure.toJordanDecomposition.posPart)
        - (∫ x, p x
          ∂(MeasureTheory.Measure.dirac ω).toSignedMeasure.toJordanDecomposition.negPart)
      = p ω
  rw [hJ]
  exact MeasureTheory.integral_dirac' p ω hp.continuous.stronglyMeasurable

/-- **The point-mass embedding is 1-Lipschitz in the KR norm.** The KR norm of `δ_ω - δ_ω'` is
bounded by `dist ω ω'`. This lets the price function `p ω := H (ofPointMass ω) - c` built from a
continuous linear functional `H` inherit a Lipschitz constant from `‖H‖`. -/
theorem norm_ofPointMass_sub_le (ω ω' : Ω) :
    ‖(ofPointMass ω - ofPointMass ω' : KRSignedMeasure Ω)‖ ≤ dist ω ω' := by
  rw [norm_def]
  set μ : KRSignedMeasure Ω := ofPointMass ω - ofPointMass ω' with hμ_def
  set s : MeasureTheory.SignedMeasure Ω := μ.toSignedMeasure with hs_def
  -- Step 1: `s univ = 0`.
  have hs_univ_zero : (s Set.univ : ℝ) = 0 := by
    have h1 : (s Set.univ : ℝ)
        = ((ofPointMass ω : KRSignedMeasure Ω).toSignedMeasure Set.univ : ℝ)
          - ((ofPointMass ω' : KRSignedMeasure Ω).toSignedMeasure Set.univ : ℝ) := by
      change (((ofPointMass ω).toSignedMeasure - (ofPointMass ω').toSignedMeasure) Set.univ : ℝ)
          = _
      rw [MeasureTheory.VectorMeasure.sub_apply]
    rw [h1, toSignedMeasure_ofPointMass_univ ω, toSignedMeasure_ofPointMass_univ ω']
    ring
  -- Step 2: bound the sup-set by `dist ω ω'`.
  set S : Set ℝ := {x : ℝ | ∃ p : Ω → ℝ, LipschitzWith 1 p ∧ p (default : Ω) = 0 ∧
    x = (∫ ω₂, p ω₂ ∂s.toJordanDecomposition.posPart)
      - (∫ ω₂, p ω₂ ∂s.toJordanDecomposition.negPart)} with hS_def
  have hzero_lip : LipschitzWith 1 (fun _ : Ω => (0 : ℝ)) :=
    (LipschitzWith.const 0).weaken (by norm_num)
  have hS_ne : S.Nonempty := ⟨0, fun _ => 0, hzero_lip, rfl, by simp⟩
  have hS_bdd : BddAbove S := bddAbove_krNorm_set (default : Ω) s
  -- Key: each element is `p ω - p ω'` for some 1-Lipschitz `p`.
  have hsup_le : sSup S ≤ dist ω ω' := by
    apply csSup_le hS_ne
    rintro x ⟨p, hp_lip, _, rfl⟩
    -- Use `signedIntegralJordan_add` on `s = δ_ω.toSignedMeasure + (-δ_ω'.toSignedMeasure)`.
    set sω : MeasureTheory.SignedMeasure Ω :=
      (ofPointMass ω : KRSignedMeasure Ω).toSignedMeasure with hsω_def
    set sω' : MeasureTheory.SignedMeasure Ω :=
      (ofPointMass ω' : KRSignedMeasure Ω).toSignedMeasure with hsω'_def
    have hs_add : s = sω + (-sω') := by
      change (ofPointMass ω - ofPointMass ω').toSignedMeasure = sω + (-sω')
      change (ofPointMass ω).toSignedMeasure - (ofPointMass ω').toSignedMeasure = sω + (-sω')
      abel
    have hadd := signedIntegralJordan_add p hp_lip sω (-sω')
    rw [← hs_add] at hadd
    -- For `-sω'`, posPart = sω'.negPart, negPart = sω'.posPart.
    have hneg_pos : (-sω').toJordanDecomposition.posPart = sω'.toJordanDecomposition.negPart := by
      rw [MeasureTheory.SignedMeasure.toJordanDecomposition_neg]; rfl
    have hneg_neg : (-sω').toJordanDecomposition.negPart = sω'.toJordanDecomposition.posPart := by
      rw [MeasureTheory.SignedMeasure.toJordanDecomposition_neg]; rfl
    rw [hneg_pos, hneg_neg] at hadd
    -- Reduce J on each Dirac to `p ω` (resp. `p ω'`) via `signedIntegral_ofPointMass`.
    have hω : (∫ x, p x ∂sω.toJordanDecomposition.posPart)
        - (∫ x, p x ∂sω.toJordanDecomposition.negPart) = p ω :=
      signedIntegral_ofPointMass hp_lip ω
    have hω' : (∫ x, p x ∂sω'.toJordanDecomposition.posPart)
        - (∫ x, p x ∂sω'.toJordanDecomposition.negPart) = p ω' :=
      signedIntegral_ofPointMass hp_lip ω'
    -- Combine: J(s,p) = p ω - p ω'.
    have hkey : (∫ ω₂, p ω₂ ∂s.toJordanDecomposition.posPart)
          - (∫ ω₂, p ω₂ ∂s.toJordanDecomposition.negPart)
        = p ω - p ω' := by
      linarith [hadd, hω, hω']
    rw [hkey]
    -- Bound by `dist ω ω'`.
    have habs : |p ω - p ω'| ≤ 1 * dist ω ω' := by
      rw [← Real.dist_eq]
      exact hp_lip.dist_le_mul ω ω'
    have h_le : p ω - p ω' ≤ |p ω - p ω'| := le_abs_self _
    have : |p ω - p ω'| ≤ dist ω ω' := by simpa using habs
    linarith
  -- Step 3: conclude.
  change |s Set.univ| + sSup S ≤ dist ω ω'
  rw [hs_univ_zero, abs_zero, zero_add]
  exact hsup_le

/-! ### Density of the point-mass span -/

/-- The submodule of `KRSignedMeasure Ω` spanned by signed point masses. -/
noncomputable def pointMassSpan : Submodule ℝ (KRSignedMeasure Ω) :=
  Submodule.span ℝ (Set.range (ofPointMass : Ω → KRSignedMeasure Ω))

/-- Point masses lie in `pointMassSpan` by construction. -/
lemma ofPointMass_mem_pointMassSpan (ω : Ω) :
    (ofPointMass ω : KRSignedMeasure Ω) ∈ pointMassSpan :=
  Submodule.subset_span ⟨ω, rfl⟩

/-! ### Algebraic identities for finite Finset-sums of signed point masses -/

/-- Test integral against a finite scalar combination of signed point masses. -/
lemma signedIntegral_finset_smul_ofPointMass {p : Ω → ℝ} (hp : LipschitzWith 1 p)
    (S : Finset Ω) (c : Ω → ℝ) :
    (∫ x, p x ∂
      (MeasureTheory.SignedMeasure.toJordanDecomposition
        ((∑ ω ∈ S, c ω • (ofPointMass ω : KRSignedMeasure Ω)).toSignedMeasure)).posPart)
      - (∫ x, p x ∂
        (MeasureTheory.SignedMeasure.toJordanDecomposition
          ((∑ ω ∈ S, c ω • (ofPointMass ω : KRSignedMeasure Ω)).toSignedMeasure)).negPart)
      = ∑ ω ∈ S, c ω * p ω := by
  classical
  induction S using Finset.induction_on with
  | empty =>
      have hzero : (∑ ω ∈ (∅ : Finset Ω), c ω • (ofPointMass ω : KRSignedMeasure Ω)) = 0 := by simp
      rw [hzero]
      change
          (∫ x, p x ∂((0 : KRSignedMeasure Ω).toSignedMeasure).toJordanDecomposition.posPart)
            - (∫ x, p x
              ∂((0 : KRSignedMeasure Ω).toSignedMeasure).toJordanDecomposition.negPart)
              = ∑ ω ∈ (∅ : Finset Ω), c ω * p ω
      have hz : ((0 : KRSignedMeasure Ω).toSignedMeasure : MeasureTheory.SignedMeasure Ω) = 0 := rfl
      rw [hz, MeasureTheory.SignedMeasure.toJordanDecomposition_zero]
      simp
  | insert ω S hω ih =>
      rw [Finset.sum_insert hω, Finset.sum_insert hω]
      set ν₁ : KRSignedMeasure Ω := c ω • (ofPointMass ω : KRSignedMeasure Ω)
      set ν₂ : KRSignedMeasure Ω := ∑ ω' ∈ S, c ω' • (ofPointMass ω' : KRSignedMeasure Ω)
      change (∫ x, p x ∂(ν₁ + ν₂).toSignedMeasure.toJordanDecomposition.posPart)
            - (∫ x, p x ∂(ν₁ + ν₂).toSignedMeasure.toJordanDecomposition.negPart)
            = c ω * p ω + ∑ ω' ∈ S, c ω' * p ω'
      have hadd : (ν₁ + ν₂).toSignedMeasure = ν₁.toSignedMeasure + ν₂.toSignedMeasure := rfl
      rw [hadd]
      rw [signedIntegralJordan_add p hp ν₁.toSignedMeasure ν₂.toSignedMeasure]
      have hν₁ : (∫ x, p x ∂ν₁.toSignedMeasure.toJordanDecomposition.posPart)
                  - (∫ x, p x ∂ν₁.toSignedMeasure.toJordanDecomposition.negPart)
                  = c ω * p ω := by
        change (∫ x, p x ∂((c ω • (ofPointMass ω).toSignedMeasure).toJordanDecomposition.posPart))
              - (∫ x, p x ∂((c ω • (ofPointMass ω).toSignedMeasure).toJordanDecomposition.negPart))
              = c ω * p ω
        rcases le_or_gt 0 (c ω) with hc | hc
        · have hpos : (c ω • (ofPointMass ω).toSignedMeasure).toJordanDecomposition.posPart
              = (c ω).toNNReal
                • (ofPointMass ω).toSignedMeasure.toJordanDecomposition.posPart := by
            rw [MeasureTheory.SignedMeasure.toJordanDecomposition_smul_real]
            exact MeasureTheory.JordanDecomposition.real_smul_posPart_nonneg _ (c ω) hc
          have hneg : (c ω • (ofPointMass ω).toSignedMeasure).toJordanDecomposition.negPart
              = (c ω).toNNReal
                • (ofPointMass ω).toSignedMeasure.toJordanDecomposition.negPart := by
            rw [MeasureTheory.SignedMeasure.toJordanDecomposition_smul_real]
            exact MeasureTheory.JordanDecomposition.real_smul_negPart_nonneg _ (c ω) hc
          rw [hpos, hneg, MeasureTheory.integral_smul_nnreal_measure,
              MeasureTheory.integral_smul_nnreal_measure]
          simp only [NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ hc]
          have h_om := signedIntegral_ofPointMass hp ω
          nlinarith [h_om]
        · have hc_le : c ω ≤ 0 := le_of_lt hc
          have hpos : (c ω • (ofPointMass ω).toSignedMeasure).toJordanDecomposition.posPart
              = (-(c ω)).toNNReal
                • (ofPointMass ω).toSignedMeasure.toJordanDecomposition.negPart := by
            rw [MeasureTheory.SignedMeasure.toJordanDecomposition_smul_real]
            exact MeasureTheory.JordanDecomposition.real_smul_posPart_neg _ (c ω) hc
          have hneg : (c ω • (ofPointMass ω).toSignedMeasure).toJordanDecomposition.negPart
              = (-(c ω)).toNNReal
                • (ofPointMass ω).toSignedMeasure.toJordanDecomposition.posPart := by
            rw [MeasureTheory.SignedMeasure.toJordanDecomposition_smul_real]
            exact MeasureTheory.JordanDecomposition.real_smul_negPart_neg _ (c ω) hc
          have hnegc_nn : 0 ≤ -(c ω) := by linarith
          rw [hpos, hneg, MeasureTheory.integral_smul_nnreal_measure,
              MeasureTheory.integral_smul_nnreal_measure]
          simp only [NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ hnegc_nn]
          have h_om := signedIntegral_ofPointMass hp ω
          nlinarith [h_om]
      rw [hν₁]
      change c ω * p ω + ((∫ x, p x ∂ν₂.toSignedMeasure.toJordanDecomposition.posPart)
            - (∫ x, p x ∂ν₂.toSignedMeasure.toJordanDecomposition.negPart))
          = c ω * p ω + ∑ ω' ∈ S, c ω' * p ω'
      rw [ih]

/-- Total mass of a Finset-sum of scaled signed point masses. -/
lemma toSignedMeasure_finset_smul_ofPointMass_univ (S : Finset Ω) (c : Ω → ℝ) :
    ((∑ ω ∈ S, c ω • (ofPointMass ω : KRSignedMeasure Ω)).toSignedMeasure Set.univ : ℝ)
      = ∑ ω ∈ S, c ω := by
  classical
  induction S using Finset.induction_on with
  | empty =>
      change ((0 : MeasureTheory.SignedMeasure Ω) Set.univ : ℝ) = 0
      simp
  | insert ω S hω ih =>
      rw [Finset.sum_insert hω, Finset.sum_insert hω]
      change ((c ω • (ofPointMass ω : KRSignedMeasure Ω)
                + ∑ ω' ∈ S, c ω' • (ofPointMass ω' : KRSignedMeasure Ω)).toSignedMeasure
                Set.univ : ℝ) = c ω + ∑ ω' ∈ S, c ω'
      change (((c ω • (ofPointMass ω : KRSignedMeasure Ω)).toSignedMeasure
                + (∑ ω' ∈ S, c ω' • (ofPointMass ω' : KRSignedMeasure Ω)).toSignedMeasure)
                Set.univ : ℝ) = c ω + ∑ ω' ∈ S, c ω'
      rw [MeasureTheory.VectorMeasure.add_apply]
      have h₁ : ((c ω • (ofPointMass ω : KRSignedMeasure Ω)).toSignedMeasure Set.univ : ℝ)
                = c ω := by
        change ((c ω • (ofPointMass ω).toSignedMeasure) Set.univ : ℝ) = c ω
        rw [MeasureTheory.VectorMeasure.smul_apply, smul_eq_mul,
            toSignedMeasure_ofPointMass_univ]
        ring
      rw [h₁, ih]

/-- The Finset-sum `∑ ω ∈ S, c ω • ofPointMass ω` lies in `pointMassSpan`. -/
lemma finset_smul_ofPointMass_mem_span (S : Finset Ω) (c : Ω → ℝ) :
    (∑ ω ∈ S, c ω • (ofPointMass ω : KRSignedMeasure Ω)) ∈
      (pointMassSpan : Submodule ℝ (KRSignedMeasure Ω)) := by
  classical
  refine Submodule.sum_mem _ ?_
  intro ω _
  exact Submodule.smul_mem _ _ (ofPointMass_mem_pointMassSpan ω)

/-! ### Sub-lemmas for the atomic-density theorem -/

omit [Inhabited Ω] in
/-- Linearity of the test integral under signed-measure subtraction:
`J(μ - ν, p) = J(μ, p) - J(ν, p)` for 1-Lipschitz `p`. -/
lemma signedIntegral_sub_decomp {p : Ω → ℝ} (hp : LipschitzWith 1 p)
    (μ ν : KRSignedMeasure Ω) :
    (∫ x, p x ∂(μ - ν).toSignedMeasure.toJordanDecomposition.posPart)
      - (∫ x, p x ∂(μ - ν).toSignedMeasure.toJordanDecomposition.negPart)
    = ((∫ x, p x ∂μ.toSignedMeasure.toJordanDecomposition.posPart)
        - (∫ x, p x ∂μ.toSignedMeasure.toJordanDecomposition.negPart))
      - ((∫ x, p x ∂ν.toSignedMeasure.toJordanDecomposition.posPart)
        - (∫ x, p x ∂ν.toSignedMeasure.toJordanDecomposition.negPart)) := by
  have hadd : (μ - ν).toSignedMeasure + ν.toSignedMeasure = μ.toSignedMeasure := by
    change μ.toSignedMeasure - ν.toSignedMeasure + ν.toSignedMeasure = μ.toSignedMeasure
    abel
  have hsi := signedIntegralJordan_add p hp (μ - ν).toSignedMeasure ν.toSignedMeasure
  rw [hadd] at hsi
  linarith [hsi]

omit [BorelSpace Ω] [CompactSpace Ω] [Inhabited Ω] in
/-- For `V : Ω → Ω` with `V x ∈ S` for all `x`, and continuous `f`:
`∑ ω ∈ S, (μ (V ⁻¹' {ω})).toReal * f ω = ∫ x, f (V x) ∂μ`. -/
lemma sum_atomicCoeff_mul_eq_integral_comp [MeasurableSingletonClass Ω]
    -- continuity of `f` is not needed since `V` only takes finitely many values in `S`
    {f : Ω → ℝ} (_hf_cont : Continuous f)
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ]
    {S : Finset Ω} {V : Ω → Ω} (hV_meas : Measurable V)
    (hV_in : ∀ x, V x ∈ (S : Set Ω)) :
    ∑ ω ∈ S, (μ (V ⁻¹' {ω})).toReal * f ω = ∫ x, f (V x) ∂μ := by
  have hVpre_meas : ∀ ω : Ω, MeasurableSet (V ⁻¹' {ω}) := fun ω =>
    hV_meas (MeasurableSet.singleton ω)
  have hind_sum :
      (fun x => f (V x))
        = fun x => ∑ ω ∈ S, (V ⁻¹' {ω}).indicator (fun _ => f ω) x := by
    funext x
    have hin : V x ∈ S := hV_in x
    rw [Finset.sum_eq_single (V x)]
    · simp [Set.indicator]
    · intro ω' _ hne
      simp only [indicator_apply_eq_zero, mem_preimage, mem_singleton_iff]
      intro h; exact (hne h.symm).elim
    · intro h; exact (h hin).elim
  rw [hind_sum, MeasureTheory.integral_finset_sum]
  · apply Finset.sum_congr rfl
    intro ω _
    rw [MeasureTheory.integral_indicator (hVpre_meas ω), MeasureTheory.setIntegral_const,
        smul_eq_mul, MeasureTheory.measureReal_def]
  · intro ω _
    exact (MeasureTheory.integrable_const _).indicator (hVpre_meas ω)

omit [Inhabited Ω] in
/-- Any composition `f ∘ V` of a continuous function with a measurable map is integrable against
any finite measure on a compact space. -/
lemma integrable_comp_measurable_of_continuous_compact {f : Ω → ℝ} (hf : Continuous f)
    {V : Ω → Ω} (hV_meas : Measurable V)
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ] :
    MeasureTheory.Integrable (fun x => f (V x)) μ := by
  let fBCF := BoundedContinuousFunction.mkOfCompact ⟨f, hf⟩
  have hf_bound : ∀ x, |f x| ≤ ‖fBCF‖ := fun x => by
    have h := BoundedContinuousFunction.norm_coe_le_norm fBCF x
    rwa [Real.norm_eq_abs] at h
  refine ⟨(hf.measurable.comp hV_meas).aestronglyMeasurable, ?_⟩
  refine (MeasureTheory.hasFiniteIntegral_const ‖fBCF‖).mono' ?_
  exact Filter.Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hf_bound (V x)

omit [Inhabited Ω] in
/-- For a 1-Lipschitz `p` and a measurable `V` with `dist x (V x) < δ` everywhere, the integral of
`p x - p (V x)` against a finite measure is bounded by `δ * μ.real univ`. -/
lemma abs_integral_sub_comp_V_le_delta_mul {p : Ω → ℝ} (hp : LipschitzWith 1 p)
    {δ : ℝ} {V : Ω → Ω} (hV_meas : Measurable V) (hV_close : ∀ x, dist x (V x) < δ)
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ] :
    |∫ x, p x - p (V x) ∂μ| ≤ δ * μ.real Set.univ := by
  have hp_int : MeasureTheory.Integrable p μ := integrable_of_lipschitz p hp μ
  have hpV_int : MeasureTheory.Integrable (fun x => p (V x)) μ :=
    integrable_comp_measurable_of_continuous_compact hp.continuous hV_meas μ
  have hint_diff : MeasureTheory.Integrable (fun x => p x - p (V x)) μ :=
    hp_int.sub hpV_int
  have hbound_int : ∫ x, |p x - p (V x)| ∂μ ≤ ∫ _x, δ ∂μ := by
    apply MeasureTheory.integral_mono_ae
    · exact hint_diff.abs
    · exact MeasureTheory.integrable_const δ
    · refine Filter.Eventually.of_forall fun x => ?_
      simp only
      have hd := hp.dist_le_mul x (V x)
      simp only [NNReal.coe_one, one_mul] at hd
      have heq : dist (p x) (p (V x)) = |p x - p (V x)| := Real.dist_eq _ _
      rw [heq] at hd
      linarith [hV_close x]
  have habs : |∫ x, p x - p (V x) ∂μ| ≤ ∫ x, |p x - p (V x)| ∂μ :=
    MeasureTheory.abs_integral_le_integral_abs
  have hint_const : ∫ _x, δ ∂μ = δ * μ.real Set.univ := by
    rw [MeasureTheory.integral_const]; simp [MeasureTheory.measureReal_def, mul_comm]
  linarith [habs, hbound_int, hint_const ▸ hbound_int]

/-! ### The main density theorem -/

/-- **Atomic approximation.** Every `μ : KRSignedMeasure Ω` is approximated to arbitrary precision
in KR norm by a finite signed combination of point masses. -/
theorem exists_pointMass_approx [MeasurableSingletonClass Ω]
    (μ : KRSignedMeasure Ω) {ε : ℝ} (hε : 0 < ε) :
    ∃ ν ∈ (pointMassSpan : Submodule ℝ (KRSignedMeasure Ω)), ‖μ - ν‖ < ε := by
  classical
  -- Setup: Jordan decomposition.
  set s : MeasureTheory.SignedMeasure Ω := μ.toSignedMeasure with hs_def
  set pos : MeasureTheory.Measure Ω := s.toJordanDecomposition.posPart with hpos_def
  set neg : MeasureTheory.Measure Ω := s.toJordanDecomposition.negPart with hneg_def
  have hpos_finite : MeasureTheory.IsFiniteMeasure pos := inferInstance
  have hneg_finite : MeasureTheory.IsFiniteMeasure neg := inferInstance
  set M : ℝ := pos.real Set.univ + neg.real Set.univ + 1 with hM_def
  have hMpos : 0 < M := by
    have h₁ : 0 ≤ pos.real Set.univ := MeasureTheory.measureReal_nonneg
    have h₂ : 0 ≤ neg.real Set.univ := MeasureTheory.measureReal_nonneg
    rw [hM_def]; linarith
  set δ : ℝ := ε / (2 * M) with hδ_def
  have h2M_pos : 0 < 2 * M := by linarith
  have hδ_pos : 0 < δ := by rw [hδ_def]; exact div_pos hε h2M_pos
  obtain ⟨S, V, hV_meas, hV_close⟩ := exists_eps_partition (Ω := Ω) δ hδ_pos
  set Vval : Ω → Ω := fun x => (V x : Ω) with hVval_def
  have hVval_meas : Measurable Vval := hV_meas.subtype_val
  set cpos : Ω → ℝ := fun ω => (pos (Vval ⁻¹' {ω})).toReal with hcpos_def
  set cneg : Ω → ℝ := fun ω => (neg (Vval ⁻¹' {ω})).toReal with hcneg_def
  set νpos : KRSignedMeasure Ω := ∑ ω ∈ S, cpos ω • (ofPointMass ω : KRSignedMeasure Ω)
    with hνpos_def
  set νneg : KRSignedMeasure Ω := ∑ ω ∈ S, cneg ω • (ofPointMass ω : KRSignedMeasure Ω)
    with hνneg_def
  set ν : KRSignedMeasure Ω := νpos - νneg with hν_def
  have hν_mem : ν ∈ (pointMassSpan : Submodule ℝ (KRSignedMeasure Ω)) := by
    rw [hν_def]
    exact Submodule.sub_mem _ (finset_smul_ofPointMass_mem_span S cpos)
      (finset_smul_ofPointMass_mem_span S cneg)
  refine ⟨ν, hν_mem, ?_⟩
  have hVpre_meas : ∀ ω : Ω, MeasurableSet (Vval ⁻¹' {ω}) := fun ω =>
    hVval_meas (MeasurableSet.singleton ω)
  have hsum_pos : ∑ ω ∈ S, pos (Vval ⁻¹' {ω}) = pos (Vval ⁻¹' (S : Set Ω)) :=
    MeasureTheory.sum_measure_preimage_singleton (μ := pos) S
      (fun y _ => hVpre_meas y)
  have hsum_neg : ∑ ω ∈ S, neg (Vval ⁻¹' {ω}) = neg (Vval ⁻¹' (S : Set Ω)) :=
    MeasureTheory.sum_measure_preimage_singleton (μ := neg) S
      (fun y _ => hVpre_meas y)
  have hVval_in_S : ∀ x, Vval x ∈ (S : Set Ω) := fun x => (V x).property
  have hVpre_univ : Vval ⁻¹' (S : Set Ω) = Set.univ := by
    ext x; simp [hVval_in_S x]
  have hsum_pos_univ : ∑ ω ∈ S, pos (Vval ⁻¹' {ω}) = pos Set.univ := by
    rw [hsum_pos, hVpre_univ]
  have hsum_neg_univ : ∑ ω ∈ S, neg (Vval ⁻¹' {ω}) = neg Set.univ := by
    rw [hsum_neg, hVpre_univ]
  have hsum_cpos : ∑ ω ∈ S, cpos ω = pos.real Set.univ := by
    simp only [hcpos_def, MeasureTheory.measureReal_def]
    rw [← ENNReal.toReal_sum (fun ω _ => MeasureTheory.measure_ne_top _ _),
        hsum_pos_univ]
  have hsum_cneg : ∑ ω ∈ S, cneg ω = neg.real Set.univ := by
    simp only [hcneg_def, MeasureTheory.measureReal_def]
    rw [← ENNReal.toReal_sum (fun ω _ => MeasureTheory.measure_ne_top _ _),
        hsum_neg_univ]
  -- Step A: total mass of μ - ν is zero.
  have hμ_univ : (s Set.univ : ℝ) = pos.real Set.univ - neg.real Set.univ := by
    have hsum : s.toJordanDecomposition.toSignedMeasure = s :=
      MeasureTheory.SignedMeasure.toSignedMeasure_toJordanDecomposition s
    have hdef : s = pos.toSignedMeasure - neg.toSignedMeasure := hsum.symm
    rw [hdef]
    exact MeasureTheory.Measure.toSignedMeasure_sub_apply (μ := pos) (ν := neg)
      (i := (Set.univ : Set Ω)) MeasurableSet.univ
  have hν_univ : (ν.toSignedMeasure Set.univ : ℝ) = pos.real Set.univ - neg.real Set.univ := by
    rw [hν_def]
    change ((νpos.toSignedMeasure - νneg.toSignedMeasure) Set.univ : ℝ) = _
    rw [MeasureTheory.VectorMeasure.sub_apply]
    rw [hνpos_def, hνneg_def]
    rw [toSignedMeasure_finset_smul_ofPointMass_univ S cpos,
        toSignedMeasure_finset_smul_ofPointMass_univ S cneg]
    rw [hsum_cpos, hsum_cneg]
  have htot_diff_zero : ((μ - ν).toSignedMeasure Set.univ : ℝ) = 0 := by
    change ((μ.toSignedMeasure - ν.toSignedMeasure) Set.univ : ℝ) = 0
    rw [MeasureTheory.VectorMeasure.sub_apply]
    change (s Set.univ : ℝ) - (ν.toSignedMeasure Set.univ : ℝ) = 0
    rw [hμ_univ, hν_univ]; ring
  -- Step B: bound on the test integral.
  have hbound : ‖μ - ν‖ ≤ δ * (pos.real Set.univ + neg.real Set.univ) := by
    rw [norm_def]
    change |((μ - ν).toSignedMeasure Set.univ : ℝ)|
        + sSup {x : ℝ | ∃ p : Ω → ℝ, LipschitzWith 1 p ∧ p (default : Ω) = 0 ∧
            x = (∫ ω, p ω ∂(μ - ν).toSignedMeasure.toJordanDecomposition.posPart)
                - (∫ ω, p ω ∂(μ - ν).toSignedMeasure.toJordanDecomposition.negPart)}
        ≤ δ * (pos.real Set.univ + neg.real Set.univ)
    rw [htot_diff_zero, abs_zero, zero_add]
    set Sset : Set ℝ := {x : ℝ | ∃ p : Ω → ℝ, LipschitzWith 1 p ∧ p (default : Ω) = 0 ∧
        x = (∫ ω, p ω ∂(μ - ν).toSignedMeasure.toJordanDecomposition.posPart)
            - (∫ ω, p ω ∂(μ - ν).toSignedMeasure.toJordanDecomposition.negPart)}
      with hSset_def
    have hzero_lip : LipschitzWith 1 (fun _ : Ω => (0 : ℝ)) :=
      (LipschitzWith.const 0).weaken (by norm_num)
    have h0_mem : (0 : ℝ) ∈ Sset := ⟨fun _ => 0, hzero_lip, rfl, by simp⟩
    have hSset_ne : Sset.Nonempty := ⟨0, h0_mem⟩
    have hSset_bdd : BddAbove Sset :=
      bddAbove_krNorm_set (default : Ω) (μ - ν).toSignedMeasure
    have hSset_bound : ∀ x ∈ Sset, x ≤ δ * (pos.real Set.univ + neg.real Set.univ) := by
      rintro x ⟨p, hp_lip, _hp0, hxeq⟩
      have hJ_split := signedIntegral_sub_decomp hp_lip μ ν
      have hJμ :
          (∫ ω, p ω ∂μ.toSignedMeasure.toJordanDecomposition.posPart)
            - (∫ ω, p ω ∂μ.toSignedMeasure.toJordanDecomposition.negPart)
          = (∫ ω, p ω ∂pos) - (∫ ω, p ω ∂neg) := rfl
      have hJν_add := signedIntegralJordan_add p hp_lip νpos.toSignedMeasure (-νneg).toSignedMeasure
      have hν_sub_eq : νpos + (-νneg) = ν := by rw [hν_def]; abel
      have hν_sm : νpos.toSignedMeasure + (-νneg).toSignedMeasure = ν.toSignedMeasure := by
        rw [← hν_sub_eq]; rfl
      rw [hν_sm] at hJν_add
      have hneg_pos : (-νneg).toSignedMeasure.toJordanDecomposition.posPart
          = νneg.toSignedMeasure.toJordanDecomposition.negPart := by
        change (- νneg.toSignedMeasure).toJordanDecomposition.posPart
              = νneg.toSignedMeasure.toJordanDecomposition.negPart
        rw [MeasureTheory.SignedMeasure.toJordanDecomposition_neg]; rfl
      have hneg_neg : (-νneg).toSignedMeasure.toJordanDecomposition.negPart
          = νneg.toSignedMeasure.toJordanDecomposition.posPart := by
        change (- νneg.toSignedMeasure).toJordanDecomposition.negPart
              = νneg.toSignedMeasure.toJordanDecomposition.posPart
        rw [MeasureTheory.SignedMeasure.toJordanDecomposition_neg]; rfl
      have hJν_add' :
          (∫ ω, p ω ∂ν.toSignedMeasure.toJordanDecomposition.posPart)
            - (∫ ω, p ω ∂ν.toSignedMeasure.toJordanDecomposition.negPart)
          = ((∫ ω, p ω ∂νpos.toSignedMeasure.toJordanDecomposition.posPart)
              - (∫ ω, p ω ∂νpos.toSignedMeasure.toJordanDecomposition.negPart))
            + ((∫ ω, p ω ∂νneg.toSignedMeasure.toJordanDecomposition.negPart)
              - (∫ ω, p ω ∂νneg.toSignedMeasure.toJordanDecomposition.posPart)) := by
        rw [hneg_pos, hneg_neg] at hJν_add
        linarith [hJν_add]
      have hJνpos := signedIntegral_finset_smul_ofPointMass hp_lip S cpos
      have hJνneg := signedIntegral_finset_smul_ofPointMass hp_lip S cneg
      have hJν :
          (∫ ω, p ω ∂ν.toSignedMeasure.toJordanDecomposition.posPart)
            - (∫ ω, p ω ∂ν.toSignedMeasure.toJordanDecomposition.negPart)
          = (∑ ω ∈ S, cpos ω * p ω) - (∑ ω ∈ S, cneg ω * p ω) := by
        linarith [hJν_add', hJνpos, hJνneg]
      have hp_cont : Continuous p := hp_lip.continuous
      have hsum_eq_int_pos : ∑ ω ∈ S, cpos ω * p ω = ∫ x, p (Vval x) ∂pos := by
        simp only [hcpos_def]
        exact sum_atomicCoeff_mul_eq_integral_comp hp_cont pos hVval_meas hVval_in_S
      have hsum_eq_int_neg : ∑ ω ∈ S, cneg ω * p ω = ∫ x, p (Vval x) ∂neg := by
        simp only [hcneg_def]
        exact sum_atomicCoeff_mul_eq_integral_comp hp_cont neg hVval_meas hVval_in_S
      have hp_int_pos : MeasureTheory.Integrable p pos := integrable_of_lipschitz p hp_lip pos
      have hp_int_neg : MeasureTheory.Integrable p neg := integrable_of_lipschitz p hp_lip neg
      have hJ_diff :
          (∫ ω, p ω ∂(μ - ν).toSignedMeasure.toJordanDecomposition.posPart)
            - (∫ ω, p ω ∂(μ - ν).toSignedMeasure.toJordanDecomposition.negPart)
          = (∫ x, p x - p (Vval x) ∂pos) - (∫ x, p x - p (Vval x) ∂neg) := by
        have hpVval_int_pos : MeasureTheory.Integrable (fun x => p (Vval x)) pos :=
          integrable_comp_measurable_of_continuous_compact hp_cont hVval_meas pos
        have hpVval_int_neg : MeasureTheory.Integrable (fun x => p (Vval x)) neg :=
          integrable_comp_measurable_of_continuous_compact hp_cont hVval_meas neg
        rw [hJ_split, hJμ, hJν, hsum_eq_int_pos, hsum_eq_int_neg]
        rw [MeasureTheory.integral_sub hp_int_pos hpVval_int_pos]
        rw [MeasureTheory.integral_sub hp_int_neg hpVval_int_neg]
        ring
      have hbound_pos : |∫ x, p x - p (Vval x) ∂pos| ≤ δ * pos.real Set.univ :=
        abs_integral_sub_comp_V_le_delta_mul hp_lip hVval_meas hV_close pos
      have hbound_neg : |∫ x, p x - p (Vval x) ∂neg| ≤ δ * neg.real Set.univ :=
        abs_integral_sub_comp_V_le_delta_mul hp_lip hVval_meas hV_close neg
      rw [hxeq, hJ_diff]
      have habs_diff :
          |(∫ x, p x - p (Vval x) ∂pos) - (∫ x, p x - p (Vval x) ∂neg)|
            ≤ δ * pos.real Set.univ + δ * neg.real Set.univ :=
        le_trans (abs_sub _ _) (add_le_add hbound_pos hbound_neg)
      have h := (abs_le.mp habs_diff).2
      nlinarith [h]
    exact csSup_le hSset_ne hSset_bound
  have hMineq : pos.real Set.univ + neg.real Set.univ ≤ M := by rw [hM_def]; linarith
  have hδpos_for_mul : 0 ≤ δ := le_of_lt hδ_pos
  have hδM : δ * (pos.real Set.univ + neg.real Set.univ) ≤ δ * M :=
    mul_le_mul_of_nonneg_left hMineq hδpos_for_mul
  have hδM_eq : δ * M = ε / 2 := by rw [hδ_def]; field_simp
  have h_lt : δ * M < ε := by rw [hδM_eq]; linarith
  linarith [hbound]

/-- **Density of the point-mass span in the KR norm.** -/
theorem pointMassSpan_dense [MeasurableSingletonClass Ω] :
    Dense (X := KRSignedMeasure Ω) ((pointMassSpan : Submodule ℝ (KRSignedMeasure Ω)) : Set _) := by
  rw [Metric.dense_iff]
  intro μ ε hε
  obtain ⟨ν, hν_mem, hν_close⟩ := exists_pointMass_approx μ hε
  refine ⟨ν, ?_, hν_mem⟩
  rw [Metric.mem_ball, dist_eq_norm, ← norm_neg, neg_sub]
  exact hν_close

/-- **A continuous linear functional vanishing on every signed point mass is zero.** Used in the
proof of `hanin_representation`. -/
theorem eq_zero_of_vanishes_on_pointMass (F : KRSignedMeasure Ω →L[ℝ] ℝ)
    [MeasurableSingletonClass Ω] (hF : ∀ ω : Ω, F (ofPointMass ω) = 0) : F = 0 := by
  apply ContinuousLinearMap.ext
  intro μ
  change F μ = 0
  -- Step 1: F vanishes on the span.
  have hspan : ∀ ν ∈ (pointMassSpan : Submodule ℝ (KRSignedMeasure Ω)), F ν = 0 := by
    intro ν hν
    refine Submodule.span_induction (p := fun w _ => F w = 0) ?_ ?_ ?_ ?_ hν
    · rintro _ ⟨ω, rfl⟩; exact hF ω
    · exact map_zero F
    · intro x y _ _ h₁ h₂; rw [map_add, h₁, h₂, add_zero]
    · intro c x _ h; rw [map_smul, h, smul_zero]
  -- Step 2: zero set of F is closed.
  have hclosed : IsClosed ({ν | F ν = 0} : Set (KRSignedMeasure Ω)) := by
    have heq : ({ν | F ν = 0} : Set _) = F ⁻¹' {0} := by ext; simp
    rw [heq]
    exact IsClosed.preimage F.continuous isClosed_singleton
  -- Step 3: closure of span is everything, so F μ = 0.
  have hsub : ((pointMassSpan : Submodule ℝ (KRSignedMeasure Ω)) : Set _) ⊆ {ν | F ν = 0} :=
    hspan
  have hclo : closure ((pointMassSpan : Submodule ℝ (KRSignedMeasure Ω)) : Set _) ⊆
      {ν | F ν = 0} := closure_minimal hsub hclosed
  exact hclo (pointMassSpan_dense μ)

