module

public import Econlib.GameTheory.ExtensiveForm.PerfectInfoTree.Tree

/-!
# Backward induction on finite perfect-information trees

This file develops backward induction on a `FinitePerfectInfoTree` (Kuhn 1953): The recursive
backward-induction value and strategy, the recursive subgame-perfect strategy predicate
`IsSubgamePerfectStrategy`, and the proof that backward induction realizes a subgame-perfect
strategy. Under genericity (no ties among a mover's continuation values), the backward-induction
strategy is the unique subgame-perfect local strategy. The file also packages the tree as an
`ExtensiveGame` via `toExtensiveGame`, with the Bellman bridge identifying the recursive
`behavioralValue` with the framework's `nodeStepValue`.

## Main definitions

* `behavioralValue`, `strategyValue`, `pureStrategyValue`: Recursive expected-payoff evaluation.
* `IsSubgamePerfectStrategy`: Recursive subgame-perfect strategy predicate.
* `backwardInductionValue`, `backwardInductionStrategy`, `backwardInductionLocalPureStrategy`,
  `backwardInductionBehavioralStrategy`: The backward-induction value and strategies.
* `IsGeneric`: No-ties predicate on a mover's backward-induction continuation values.
* `toExtensiveGame`: The tree as a perfect-information `ExtensiveGame`.
* `depth`, `isMoverAt`: Tree depth and the local-mover predicate.

## Main statements

* `backwardInductionStrategy_isSubgamePerfect`: Backward induction is subgame perfect.
* `IsSubgamePerfectStrategy.eq_backwardInductionStrategy`: In a generic tree, the
  backward-induction strategy is the unique subgame-perfect local strategy.
* `finiteDepth`: The embedded extensive form has finite depth `T.depth`.
* `unilateralDeviation_iff_isMoverAt`: The extensive-form unilateral-deviation predicate is
  agreement at every history where player `i` is not the mover.

## References

* Kuhn, H. W. 1953. “Extensive Games and the Problem of Information.” In *Contributions to the
  Theory of Games, Volume II*, edited by H. W. Kuhn and A. W. Tucker. Princeton University Press.

## Tags

backward induction, subgame perfect equilibrium, perfect information, extensive form
-/

@[expose] public noncomputable section

open BigOperators

/-- Discharge the strict-dominance side goal `∀ c' ≠ c, value c' < value c` generated by
`backwardInductionValue_decision_eq_of_strictArgmax` (or the analogous
`bestChoice_eq_of_strictArgmax` goal) on a concrete `Fin n` choice type. Closes each branch by
`rfl`-distinctness, a named hypothesis, or `norm_num` with the supplied simp arguments. The chosen
child `c` survives `fin_cases` as a literal `![…] c` lookup on the comparison's right-hand side;
for ternary and wider trees that index lacks a default `@[simp]` reduction, so each branch first
runs the `Matrix.cons_val` simproc to evaluate every `![…] i` lookup before `norm_num` (which then
collapses terminal children via the `@[simp]` `backwardInductionValue_terminal`). -/
macro "bi_dominates" args:(Lean.Parser.Tactic.simpArgs)? : tactic =>
  `(tactic| (intro c' hc'; fin_cases c' <;>
      first
        | exact absurd rfl hc'
        | assumption
        | (simp only [Matrix.cons_val] <;> norm_num $[$args]?)))

/-- Discharge the ordered-pair distinctness side goal `∀ a b, a < b → value a ≠ value b` generated
by `isGeneric_decision_of_pairwise_lt` on a concrete `Fin n` choice type. The genericity analog of
`bi_dominates`; closes each ordered pair by a named hypothesis or by `norm_num` with the supplied
simp arguments. -/
macro "bi_pairwise_ne" args:(Lean.Parser.Tactic.simpArgs)? : tactic =>
  `(tactic| (intro a b hab; fin_cases a <;> fin_cases b <;>
      first | exact absurd hab (by decide) | assumption | norm_num $[$args]?))

namespace Econlib.GameTheory

namespace FinitePerfectInfoTree

variable {I E : Type u}

/-- Expected payoff induced by a per-history behavioral profile on the embedded game form. -/
noncomputable def behavioralValue :
    (T : FinitePerfectInfoTree I E) → T.RawBehavioral → I → ℝ
  | .terminal payoff, _σ, i => payoff i
  | @FinitePerfectInfoTree.decision _ _ mover Choice _ _ _ _ emit child, σ, i =>
      let beh : stdSimplex ℝ Choice := σ []
      ∑ c : Choice,
        (beh : Choice → ℝ) c *
          (child c).behavioralValue
            (shiftBehavioralAtChoice mover Choice emit child σ c) i

/-- Restrict a per-history behavioral profile on a tree to the subtree at a given history. -/
def subtreeBehavioral (T : FinitePerfectInfoTree I E) (σ : T.RawBehavioral)
    (h : List E) : (T.subtreeAt h).RawBehavioral :=
  fun rest => by
    have hAppend : T.subtreeAt (h ++ rest) = (T.subtreeAt h).subtreeAt rest :=
      T.subtreeAt_append h rest
    have hType :
        (T.subtreeAt (h ++ rest)).rootNodeKind.Behavior =
          ((T.subtreeAt h).subtreeAt rest).rootNodeKind.Behavior := by
      rw [hAppend]
    exact cast hType (σ (h ++ rest))

/-- Expected payoff induced by a local finite-tree strategy. -/
def strategyValue : (T : FinitePerfectInfoTree I E) → T.LocalBehavioralStrategy → I → ℝ
  | .terminal payoff, _s => payoff
  | @FinitePerfectInfoTree.decision _ _ _mover Choice _ _ _ _ _emit child, s =>
      fun i => ∑ c : Choice, s.1 c * (child c).strategyValue (s.2 c) i

/-- At a terminal tree, the strategy value is the realized payoff. -/
@[simp] theorem strategyValue_terminal (payoff : I → ℝ)
    (s : LocalBehavioralStrategy (.terminal (I := I) (E := E) payoff)) (i : I) :
    (FinitePerfectInfoTree.terminal (I := I) (E := E) payoff).strategyValue s i = payoff i :=
  rfl

/-- At a decision node, the strategy value averages child values against the root mix `s.1`. -/
@[simp] theorem strategyValue_decision
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E)
    (s : LocalBehavioralStrategy (.decision mover Choice emit child)) (i : I) :
    (FinitePerfectInfoTree.decision mover Choice emit child).strategyValue s i =
      ∑ c : Choice, s.1 c * (child c).strategyValue (s.2 c) i := rfl

/-- Recursive finite-tree subgame perfection: At every subtree, the current mixed action is at
least as good for the mover as any pure root action followed by the same continuation strategies,
and all continuation strategies are themselves subgame perfect. This is the primary subgame-perfect
notion for finite trees — `Choice`-indexed and free of history-cast machinery. -/
def IsSubgamePerfectStrategy : (T : FinitePerfectInfoTree I E) → T.LocalBehavioralStrategy → Prop
  | .terminal _payoff, _s => True
  | @FinitePerfectInfoTree.decision _ _ mover Choice _ _ _ _ _emit child, s =>
      (∀ c : Choice,
        (child c).strategyValue (s.2 c) mover ≤
          ∑ c' : Choice, s.1 c' * (child c').strategyValue (s.2 c') mover) ∧
        ∀ c : Choice, (child c).IsSubgamePerfectStrategy (s.2 c)

/-- Every strategy at a terminal tree is vacuously subgame perfect. -/
@[simp] theorem isSubgamePerfectStrategy_terminal (payoff : I → ℝ)
    (s : LocalBehavioralStrategy (.terminal (I := I) (E := E) payoff)) :
    (FinitePerfectInfoTree.terminal (I := I) (E := E) payoff).IsSubgamePerfectStrategy s := by
  trivial

/-- Unfolding of `IsSubgamePerfectStrategy` at a decision node: Root optimality for the mover
together with subgame perfection of every continuation strategy. -/
theorem isSubgamePerfectStrategy_decision
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E)
    (s : LocalBehavioralStrategy (.decision mover Choice emit child)) :
    (FinitePerfectInfoTree.decision mover Choice emit child).IsSubgamePerfectStrategy s ↔
      (∀ c : Choice,
        (child c).strategyValue (s.2 c) mover ≤
          ∑ c' : Choice, s.1 c' * (child c').strategyValue (s.2 c') mover) ∧
        ∀ c : Choice, (child c).IsSubgamePerfectStrategy (s.2 c) := by
  rfl

/-- Embed a local pure strategy as a local behavioral strategy. -/
noncomputable def LocalPureStrategy.toStrategy :
    (T : FinitePerfectInfoTree I E) → T.LocalPureStrategy → T.LocalBehavioralStrategy
  | .terminal _payoff, _s => PUnit.unit
  | @FinitePerfectInfoTree.decision _ _ _mover _Choice _ _ _ _ _emit child, s =>
      (stdSimplex.vertex (S := ℝ) s.1, fun c => (s.2 c).toStrategy (child c))

/-- Payoff induced by a local pure strategy, following the selected branch at each node. -/
def pureStrategyValue : (T : FinitePerfectInfoTree I E) → T.LocalPureStrategy → I → ℝ
  | .terminal payoff, _s => payoff
  | @FinitePerfectInfoTree.decision _ _ _mover _Choice _ _ _ _ _emit child, s =>
      (child s.1).pureStrategyValue (s.2 s.1)

/-- At a terminal tree, the pure-strategy value is the realized payoff. -/
@[simp] theorem pureStrategyValue_terminal (payoff : I → ℝ)
    (s : LocalPureStrategy (.terminal (I := I) (E := E) payoff)) (i : I) :
    (FinitePerfectInfoTree.terminal (I := I) (E := E) payoff).pureStrategyValue s i =
      payoff i :=
  rfl

/-- At a decision node, the pure-strategy value follows the selected branch `s.1`. -/
@[simp] theorem pureStrategyValue_decision
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E)
    (s : LocalPureStrategy (.decision mover Choice emit child)) (i : I) :
    (FinitePerfectInfoTree.decision mover Choice emit child).pureStrategyValue s i =
      (child s.1).pureStrategyValue (s.2 s.1) i := rfl

/-- Backward-induction continuation values for the scoped finite tree. -/
noncomputable def backwardInductionValue : FinitePerfectInfoTree I E → I → ℝ
  | .terminal payoff => payoff
  | @FinitePerfectInfoTree.decision _ _ mover Choice _ _ _ _ _emit child =>
      fun i =>
        let c := bestChoice Choice (fun c => (child c).backwardInductionValue mover)
        (child c).backwardInductionValue i

/-- At a terminal tree, the backward-induction value is the realized payoff. -/
@[simp] theorem backwardInductionValue_terminal (payoff : I → ℝ) (i : I) :
    (FinitePerfectInfoTree.terminal (I := I) (E := E) payoff).backwardInductionValue i =
      payoff i :=
  rfl

/-- Equation lemma at a decision node: The backward-induction value is the value of the subtree at
the mover's `bestChoice`. -/
theorem backwardInductionValue_decision
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E) (i : I) :
    (FinitePerfectInfoTree.decision mover Choice emit child).backwardInductionValue i =
      (child (bestChoice Choice
        (fun c => (child c).backwardInductionValue mover))).backwardInductionValue i :=
  rfl

/-- **Strict-argmax collapse.** When choice `c` gives the mover a strictly greater continuation
value than every other choice, the decision node's backward-induction value, for every player `i`,
is the value of the subtree at `c`. -/
theorem backwardInductionValue_decision_eq_of_strictArgmax
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E) (c : Choice)
    (h : ∀ c' : Choice, c' ≠ c →
      (child c').backwardInductionValue mover < (child c).backwardInductionValue mover)
    (i : I) :
    (FinitePerfectInfoTree.decision mover Choice emit child).backwardInductionValue i =
      (child c).backwardInductionValue i := by
  rw [backwardInductionValue_decision,
    bestChoice_eq_of_strictArgmax Choice (fun c => (child c).backwardInductionValue mover) c h]

/-- The root choice selected by backward induction, represented as a pure local choice. -/
noncomputable def backwardInductionRootChoice
    (T : FinitePerfectInfoTree I E) : T.rootNodeKind.PureChoice :=
  match T with
  | .terminal _payoff => PUnit.unit
  | @FinitePerfectInfoTree.decision _ _ mover Choice _ _ _ _ _emit child =>
      bestChoice Choice (fun c => (child c).backwardInductionValue mover)

/-- At a decision node, the backward-induction choice maximizes the mover's continuation value. -/
theorem backwardInductionRootChoice_isBest
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E) (c : Choice) :
    (child c).backwardInductionValue mover ≤
      (child (backwardInductionRootChoice
        (.decision mover Choice emit child))).backwardInductionValue mover :=
  bestChoice_isBest Choice (fun c => (child c).backwardInductionValue mover) c

/-- The local finite-tree strategy selected by backward induction. -/
noncomputable def backwardInductionStrategy :
    (T : FinitePerfectInfoTree I E) → T.LocalBehavioralStrategy
  | .terminal _payoff => PUnit.unit
  | @FinitePerfectInfoTree.decision _ _ mover Choice _ _ _ _ _emit child =>
      (stdSimplex.vertex (bestChoice Choice
        (fun c => (child c).backwardInductionValue mover)),
        fun c => (child c).backwardInductionStrategy)

/-- The local pure strategy selected by backward induction. -/
noncomputable def backwardInductionLocalPureStrategy :
    (T : FinitePerfectInfoTree I E) → T.LocalPureStrategy
  | .terminal _payoff => PUnit.unit
  | @FinitePerfectInfoTree.decision _ _ mover Choice _ _ _ _ _emit child =>
      let c := bestChoice Choice (fun c => (child c).backwardInductionValue mover)
      (c, fun c => (child c).backwardInductionLocalPureStrategy)

/-- Averaging `f` against the vertex simplex at `cStar` returns `f cStar`. -/
lemma sum_pure_mul (Choice : Type u) [Fintype Choice] [DecidableEq Choice]
    (cStar : Choice) (f : Choice → ℝ) :
    (∑ c : Choice, (stdSimplex.vertex (S := ℝ) cStar : stdSimplex ℝ Choice) c * f c) =
      f cStar := by
  have hv : ∀ c, (stdSimplex.vertex (S := ℝ) cStar : stdSimplex ℝ Choice) c * f c
      = if c = cStar then f c else 0 := by
    intro c
    rw [stdSimplex.vertex_coe, Pi.single_apply]
    split_ifs <;> simp
  simp only [hv, Finset.sum_ite_eq', Finset.mem_univ, if_true]

/-- The backward-induction strategy induces the recursively defined backward-induction value. -/
@[simp] theorem strategyValue_backwardInductionStrategy
    (T : FinitePerfectInfoTree I E) (i : I) :
    T.strategyValue T.backwardInductionStrategy i = T.backwardInductionValue i := by
  induction T with
  | terminal payoff => rfl
  | decision mover Choice emit child ih =>
      change
        (∑ c : Choice,
          (stdSimplex.vertex (S := ℝ) (bestChoice Choice
            (fun c => (child c).backwardInductionValue mover)) : stdSimplex ℝ Choice) c *
            (child c).strategyValue (child c).backwardInductionStrategy i) =
          (child (bestChoice Choice
            (fun c => (child c).backwardInductionValue mover))).backwardInductionValue i
      simp only [ih]
      exact sum_pure_mul Choice _ (fun c => (child c).backwardInductionValue i)

/-- The local pure backward-induction strategy induces the backward-induction value. -/
@[simp] theorem pureStrategyValue_backwardInductionLocalPureStrategy
    (T : FinitePerfectInfoTree I E) (i : I) :
    T.pureStrategyValue T.backwardInductionLocalPureStrategy i =
      T.backwardInductionValue i := by
  induction T with
  | terminal payoff => rfl
  | decision mover Choice emit child ih =>
      simp [pureStrategyValue, backwardInductionLocalPureStrategy, backwardInductionValue, ih]

/-- The local pure backward-induction strategy embeds to the local mixed backward-induction
strategy. -/
theorem backwardInductionLocalPureStrategy_toStrategy
    (T : FinitePerfectInfoTree I E) :
    LocalPureStrategy.toStrategy T T.backwardInductionLocalPureStrategy =
      T.backwardInductionStrategy := by
  induction T with
  | terminal payoff => rfl
  | decision mover Choice emit child ih =>
      simp [LocalPureStrategy.toStrategy, backwardInductionLocalPureStrategy,
        backwardInductionStrategy, ih]

/-- Backward induction is subgame perfect for the semantic finite-tree predicate. -/
theorem backwardInductionStrategy_isSubgamePerfect
    (T : FinitePerfectInfoTree I E) :
    T.IsSubgamePerfectStrategy T.backwardInductionStrategy := by
  induction T with
  | terminal payoff => trivial
  | decision mover Choice emit child ih =>
      refine ⟨fun c => ?_, ih⟩
      change (child c).strategyValue (child c).backwardInductionStrategy mover ≤
        (∑ c' : Choice,
          (stdSimplex.vertex (S := ℝ) (bestChoice Choice
            (fun c => (child c).backwardInductionValue mover)) : stdSimplex ℝ Choice) c' *
            (child c').strategyValue (child c').backwardInductionStrategy mover)
      simp only [strategyValue_backwardInductionStrategy, sum_pure_mul]
      exact bestChoice_isBest Choice (fun c => (child c).backwardInductionValue mover) c

/-- The local pure backward-induction strategy is optimal at each subtree after embedding as a
behavioral finite-tree strategy. -/
theorem backwardInductionLocalPureStrategy_isSubgamePerfect
    (T : FinitePerfectInfoTree I E) :
    T.IsSubgamePerfectStrategy
      (LocalPureStrategy.toStrategy T T.backwardInductionLocalPureStrategy) := by
  rw [backwardInductionLocalPureStrategy_toStrategy]
  exact T.backwardInductionStrategy_isSubgamePerfect

/-! ### Uniqueness of subgame-perfect equilibrium in generic trees

`backwardInductionStrategy_isSubgamePerfect` gives existence; the converse needs to rule out
payoff ties, since when two choices give the mover the same continuation value any mixture between
them is also subgame perfect. The sufficient hypothesis is **genericity**: No ties among the
mover's backward-induction continuation values at any decision node. -/

/-- A finite perfect-information tree is **generic** when, at every decision node, distinct choices
give the mover distinct backward-induction continuation values — no payoff ties anywhere in the
backward-induction pass. Generic trees have a unique subgame-perfect strategy
(`IsSubgamePerfectStrategy.eq_backwardInductionStrategy`).

The name follows standard game-theory usage: Payoff assignments avoiding ties are "generic", since
the tie locus is a null set in payoff space. -/
def IsGeneric : FinitePerfectInfoTree I E → Prop
  | .terminal _payoff => True
  | @FinitePerfectInfoTree.decision _ _ mover Choice _ _ _ _ _emit child =>
      Function.Injective (fun c => (child c).backwardInductionValue mover) ∧
        ∀ c : Choice, (child c).IsGeneric

/-- A terminal tree is vacuously generic. -/
@[simp] theorem isGeneric_terminal (payoff : I → ℝ) :
    (FinitePerfectInfoTree.terminal (I := I) (E := E) payoff).IsGeneric := by
  trivial

/-- Unfolding of `IsGeneric` at a decision node: Injective continuation values plus genericity of
every child. -/
theorem isGeneric_decision
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E) :
    (FinitePerfectInfoTree.decision mover Choice emit child).IsGeneric ↔
      Function.Injective (fun c => (child c).backwardInductionValue mover) ∧
        ∀ c : Choice, (child c).IsGeneric := by
  rfl

/-- **Genericity from below-diagonal pairwise distinctness.** Over a linearly ordered choice type,
genericity at a decision node follows from distinctness of the mover's continuation values on
ordered pairs `a < b` together with genericity of every child. -/
theorem isGeneric_decision_of_pairwise_lt
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice] [LinearOrder Choice]
    (emit : Choice ↪ E)
    (child : Choice → FinitePerfectInfoTree I E)
    (hne : ∀ a b : Choice, a < b →
      (child a).backwardInductionValue mover ≠ (child b).backwardInductionValue mover)
    (hchild : ∀ c : Choice, (child c).IsGeneric) :
    (FinitePerfectInfoTree.decision mover Choice emit child).IsGeneric := by
  rw [isGeneric_decision]
  exact ⟨.of_lt_imp_ne hne, hchild⟩

/-- Reduce a concrete decision-node `IsGeneric` goal to one goal per child, via
`isGeneric_decision_of_pairwise_lt`: It discharges the mover-value distinctness with
`bi_pairwise_ne` and the supplied simp arguments, then case-splits the child index.

Leaves one goal `(child i).IsGeneric` per choice `i`; the caller closes each —
`<;> exact
isGeneric_terminal _` when every child is terminal, or one bullet per child otherwise.
The child index is consumed by `fin_cases`, so this only applies to concrete `Fin n` choice types;
for an abstract child family, call `isGeneric_decision_of_pairwise_lt` with `bi_pairwise_ne`
directly. -/
macro "bi_generic" args:(Lean.Parser.Tactic.simpArgs)? : tactic =>
  `(tactic| refine isGeneric_decision_of_pairwise_lt _ _ _ _ (by bi_pairwise_ne $[$args]?) ?_ <;>
      (intro c; fin_cases c))

/-- Structural-recursion core of subgame-perfect uniqueness, with the strategy explicitly
quantified so the inductive hypothesis is available at each child. The public form is
`IsSubgamePerfectStrategy.eq_backwardInductionStrategy`. -/
private theorem eq_backwardInductionStrategy_aux :
    ∀ (T : FinitePerfectInfoTree I E) (s : T.LocalBehavioralStrategy),
      T.IsGeneric → T.IsSubgamePerfectStrategy s → s = T.backwardInductionStrategy := by
  intro T
  induction T with
  | terminal payoff =>
      -- The strategy carrier is `PUnit`; both sides reduce to `PUnit.unit`.
      intro s _ _
      cases s
      rfl
  | decision mover Choice emit child ih =>
      intro s hgen hspe
      obtain ⟨w, k⟩ := s
      rw [isGeneric_decision] at hgen
      obtain ⟨hinj, hgenc⟩ := hgen
      rw [isSubgamePerfectStrategy_decision] at hspe
      obtain ⟨hroot, hrec⟩ := hspe
      -- The inductive hypothesis forces every continuation strategy to be the
      -- backward-induction one.
      have hk : ∀ c, k c = (child c).backwardInductionStrategy := fun c =>
        ih c (k c) (hgenc c) (hrec c)
      -- Abbreviate the mover's continuation values and the backward-induction best choice.
      set f : Choice → ℝ := fun c => (child c).backwardInductionValue mover with hf
      set cStar : Choice := bestChoice Choice f with hcStar
      -- Each continuation value under `k` equals the backward-induction continuation value.
      have hcontval : ∀ c, (child c).strategyValue (k c) mover = f c := by
        intro c
        rw [hk c, strategyValue_backwardInductionStrategy]
      -- `cStar` is a strict argmax: distinct choices give strictly smaller values (genericity).
      have hstrict : ∀ c, c ≠ cStar → f c < f cStar := by
        intro c hcne
        refine lt_of_le_of_ne (bestChoice_isBest Choice f c) ?_
        intro heq
        exact hcne (hinj heq)
      -- The root optimality at `cStar` rewrites to `f cStar ≤ ∑ c', w c' * f c'`.
      have hroot_star : f cStar ≤ ∑ c' : Choice, (w : Choice → ℝ) c' * f c' := by
        have := hroot cStar
        rw [hcontval cStar] at this
        simpa only [hcontval] using this
      -- Simplex weights are nonnegative and sum to one.
      have hw_nonneg : ∀ c, 0 ≤ (w : Choice → ℝ) c := w.2.1
      have hw_sum : ∑ c : Choice, (w : Choice → ℝ) c = 1 := w.2.2
      -- The reverse bound: averaging values cannot exceed the maximum value.
      have hsum_le : (∑ c' : Choice, (w : Choice → ℝ) c' * f c') ≤ f cStar := by
        calc
          (∑ c' : Choice, (w : Choice → ℝ) c' * f c')
              ≤ ∑ c' : Choice, (w : Choice → ℝ) c' * f cStar :=
                Finset.sum_le_sum fun c' _ =>
                  mul_le_mul_of_nonneg_left (bestChoice_isBest Choice f c') (hw_nonneg c')
          _ = (∑ c' : Choice, (w : Choice → ℝ) c') * f cStar := by rw [Finset.sum_mul]
          _ = f cStar := by rw [hw_sum, one_mul]
      -- Hence the average equals the maximum.
      have hsum_eq : (∑ c' : Choice, (w : Choice → ℝ) c' * f c') = f cStar :=
        le_antisymm hsum_le hroot_star
      -- The slack `∑ w c' * (f cStar - f c')` is zero and each summand is nonnegative,
      -- so every non-maximal choice carries zero weight.
      have hslack_zero : ∑ c' : Choice, (w : Choice → ℝ) c' * (f cStar - f c') = 0 := by
        have hexpand : ∑ c' : Choice, (w : Choice → ℝ) c' * (f cStar - f c') =
            f cStar - ∑ c' : Choice, (w : Choice → ℝ) c' * f c' := by
          simp_rw [mul_sub]
          rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hw_sum, one_mul]
        rw [hexpand, hsum_eq, sub_self]
      have hterm_nonneg : ∀ c' ∈ (Finset.univ : Finset Choice),
          0 ≤ (w : Choice → ℝ) c' * (f cStar - f c') := by
        intro c' _
        rcases eq_or_ne c' cStar with h | h
        · subst h; simp
        · exact mul_nonneg (hw_nonneg c') (by linarith [hstrict c' h])
      have hterm_zero : ∀ c' ∈ (Finset.univ : Finset Choice),
          (w : Choice → ℝ) c' * (f cStar - f c') = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg hterm_nonneg).mp hslack_zero
      -- Non-maximal choices have zero weight; the maximal choice carries all the mass.
      have hw_zero : ∀ c, c ≠ cStar → (w : Choice → ℝ) c = 0 := by
        intro c hcne
        have hposgap : 0 < f cStar - f c := by linarith [hstrict c hcne]
        have := hterm_zero c (Finset.mem_univ c)
        rcases mul_eq_zero.mp this with h | h
        · exact h
        · exact absurd h (by linarith)
      have hw_star : (w : Choice → ℝ) cStar = 1 := by
        have hsplit : ∑ c : Choice, (w : Choice → ℝ) c =
            (w : Choice → ℝ) cStar := by
          rw [Finset.sum_eq_single cStar]
          · intro c _ hcne; exact hw_zero c hcne
          · intro h; exact absurd (Finset.mem_univ cStar) h
        rw [← hsplit, hw_sum]
      -- The root simplex weight is the vertex at `cStar`.
      have hw_vertex : w = stdSimplex.vertex (S := ℝ) cStar := by
        apply Subtype.ext
        funext c
        change (w : Choice → ℝ) c = (stdSimplex.vertex (S := ℝ) cStar : stdSimplex ℝ Choice) c
        rw [stdSimplex.vertex_coe, Pi.single_apply]
        rcases eq_or_ne c cStar with h | h
        · subst h; rw [if_pos rfl]; exact hw_star
        · rw [if_neg h]; exact hw_zero c h
      -- Assemble: the pair `(w, k)` equals the backward-induction decision strategy.
      change (w, k) = _
      rw [hw_vertex]
      exact Prod.ext rfl (funext hk)

/-- **Uniqueness of subgame-perfect equilibrium in generic finite perfect-information trees.** If
no decision node has ties among the mover's backward-induction continuation values, then the
backward-induction strategy is the only subgame-perfect **local** strategy
(`LocalBehavioralStrategy`); no mixing survives, since mixing at a decision node would put weight
on a strictly inferior continuation.

Uniqueness is at the local-strategy level: A flat `BehavioralStrategy` on the extensive lift also
carries irrelevant off-tree and non-mover coordinates that no equilibrium notion determines. See
`eq_backwardInductionStrategy_of_isSubgamePerfectEquilibrium` for the flat form on canonical
embeddings. -/
theorem IsSubgamePerfectStrategy.eq_backwardInductionStrategy
    {T : FinitePerfectInfoTree I E} {s : T.LocalBehavioralStrategy}
    (hgen : T.IsGeneric) (hspe : T.IsSubgamePerfectStrategy s) :
    s = T.backwardInductionStrategy :=
  eq_backwardInductionStrategy_aux T s hgen hspe

/-- In a generic tree, every subgame-perfect strategy attains the backward-induction value. This is
the value-level form of SPE uniqueness. -/
theorem IsSubgamePerfectStrategy.strategyValue_eq_backwardInductionValue
    {T : FinitePerfectInfoTree I E} {s : T.LocalBehavioralStrategy}
    (hgen : T.IsGeneric) (hspe : T.IsSubgamePerfectStrategy s) (i : I) :
    T.strategyValue s i = T.backwardInductionValue i := by
  rw [hspe.eq_backwardInductionStrategy hgen, strategyValue_backwardInductionStrategy]

/-- The raw per-history behavioral profile from backward induction on the embedded game tree. -/
noncomputable def backwardInductionRaw
    (T : FinitePerfectInfoTree I E) : T.RawBehavioral :=
  LocalBehavioralStrategy.toBehavioral T T.backwardInductionStrategy

/-- The behavioral backward-induction strategy on the embedded perfect-information form. -/
noncomputable def backwardInductionBehavioralStrategy [DecidableEq I]
    (T : FinitePerfectInfoTree I E) : T.toExtensiveForm.BehavioralStrategy :=
  ExtensiveForm.BehavioralStrategy.ofPerfectInfo T.backwardInductionRaw

/-- Player `i` is the local mover at history `h`: The subtree at `h` is a decision node whose mover
is `i`. Terminal subtrees vacuously have no mover. -/
def isMoverAt (T : FinitePerfectInfoTree I E) (h : List E) (i : I) : Prop :=
  match T.subtreeAt h with
  | .terminal _ => False
  | @FinitePerfectInfoTree.decision _ _ mover _ _ _ _ _ _ _ => mover = i

/-! ### Finite depth: Bounding tree depth and proving FiniteDepth -/

/-- Depth of a finite perfect-information tree (longest path to a terminal). -/
def depth : FinitePerfectInfoTree I E → ℕ
  | .terminal _ => 0
  | @FinitePerfectInfoTree.decision _ _ _ Choice _ _ _ _ _ child =>
      1 + (Finset.univ.image (fun c : Choice => (child c).depth)).max.getD 0

/-- The depth of any child is at most one less than the parent's depth. -/
private lemma child_depth_lt
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E) (child : Choice → FinitePerfectInfoTree I E) (c : Choice) :
    (child c).depth + 1 ≤ (FinitePerfectInfoTree.decision mover Choice emit child).depth := by
  change (child c).depth + 1 ≤ 1 + _
  set S : Finset ℕ := Finset.univ.image (fun c : Choice => (child c).depth)
  have hmem : (child c).depth ∈ S :=
    Finset.mem_image.mpr ⟨c, Finset.mem_univ _, rfl⟩
  obtain ⟨m, hM⟩ := Finset.max_of_nonempty ⟨_, hmem⟩
  rw [hM]
  change (child c).depth + 1 ≤ 1 + m
  have : (child c).depth ≤ m := Finset.le_max_of_eq hmem hM
  omega

/-- The depth bound: At any history `h` with `T.depth ≤ h.length`, the subtree is terminal. -/
lemma depth_le_subtreeAt_terminal :
    ∀ (T : FinitePerfectInfoTree I E) (h : List E),
      T.depth ≤ h.length → ∃ p : I → ℝ, T.subtreeAt h = .terminal p := by
  intro T
  induction T with
  | terminal payoff =>
      intro h _
      -- a terminal subtree is `terminal payoff` at every history
      exact ⟨payoff, by cases h <;> rfl⟩
  | decision mover Choice emit child ih =>
      intro h hlen
      cases h with
      | nil =>
          -- depth is `1 + _ ≥ 1` but `[].length = 0`, contradiction
          change 1 + _ ≤ 0 at hlen
          omega
      | cons e rest =>
          cases hdec : decodeEmit emit e with
          | some c =>
              have hsub : (FinitePerfectInfoTree.decision mover Choice emit child).subtreeAt
                  (e :: rest) = (child c).subtreeAt rest := by
                conv_lhs => unfold subtreeAt
                rw [hdec]
              have hchild_le : (child c).depth ≤ rest.length := by
                -- chain `(child c).depth + 1 ≤ depth ≤ (e :: rest).length = rest.length + 1`
                have hparent_le := (child_depth_lt mover Choice emit child c).trans hlen
                rw [List.length_cons] at hparent_le
                omega
              rcases ih c rest hchild_le with ⟨p, hp⟩
              exact ⟨p, hsub.trans hp⟩
          | none =>
              -- subtreeAt is junk terminal
              refine ⟨fun _ => 0, ?_⟩
              conv_lhs => unfold subtreeAt
              rw [hdec]

/-- Finite-depth witness for the embedded extensive form. -/
lemma finiteDepth [DecidableEq I] (T : FinitePerfectInfoTree I E) :
    T.toExtensiveForm.FiniteDepth T.depth := by
  intro h hlen
  rcases T.depth_le_subtreeAt_terminal h hlen with ⟨p, hp⟩
  refine ⟨p, ?_⟩
  change T.nodeKindAt h = .terminal p
  unfold nodeKindAt rootNodeKind
  rw [hp]

/-! ### Bellman bridge: `behavioralValue` matches `nodeStepValue` -/

/-- HEq congruence for `behavioralValue`: Equal trees and HEq strategies give equal values. -/
private theorem behavioralValue_heq_congr_local {T1 T2 : FinitePerfectInfoTree I E}
    (hT : T1 = T2) {σ1 : T1.RawBehavioral} {σ2 : T2.RawBehavioral} (hσ : HEq σ1 σ2) (i : I) :
    T1.behavioralValue σ1 i = T2.behavioralValue σ2 i := by
  subst hT
  rw [eq_of_heq hσ]

/-- A finite perfect-information tree has no general-chance node at any history (only terminal and
player nodes), so `nodeStepValue`'s no-general-chance obligation is discharged everywhere. -/
lemma nodeKind_ne_chanceGeneral [DecidableEq I] (T : FinitePerfectInfoTree I E)
    (h : List E) :
    ∀ n : ChanceGeneralNode E, T.toExtensiveForm.tree.nodeKind h ≠ .chanceGeneral n := by
  intro n hk
  change T.nodeKindAt h = .chanceGeneral n at hk
  unfold nodeKindAt rootNodeKind at hk
  cases hsub : T.subtreeAt h with
  | terminal _ => rw [hsub] at hk; cases hk
  | decision _ _ _ _ => rw [hsub] at hk; cases hk

/-- Generic congruence for `nodeStepValue` along the discriminant equality `nk1 = nk2`. The proof
`hk2 : G.tree.nodeKind h = nk2` is required to typecheck the RHS; the two no-general-chance proofs
are interchangeable by proof irrelevance. -/
private lemma nodeStepValue_discr_congr {I E : Type u}
    (G : ExtensiveForm I E) (σ : G.BehavioralStrategy) (h : List E) (i : I)
    {nk1 nk2 : NodeKind I E} (hnk1 : G.tree.nodeKind h = nk1) (hnk2 : G.tree.nodeKind h = nk2)
    (hng1 : ∀ n : ChanceGeneralNode E, nk1 ≠ .chanceGeneral n)
    (hng2 : ∀ n : ChanceGeneralNode E, nk2 ≠ .chanceGeneral n)
    (stepPayoff : List E → E → I → ℝ) (discount : ℝ)
    (V : G.BehavioralStrategy → List E → I → ℝ) :
    nodeStepValue G σ h i nk1 hnk1 hng1 stepPayoff discount V =
      nodeStepValue G σ h i nk2 hnk2 hng2 stepPayoff discount V := by
  have hnk_eq : nk1 = nk2 := hnk1.symm.trans hnk2
  subst hnk_eq
  rfl

/-- Bellman bridge — terminal case. When `T.subtreeAt h = .terminal p`, the LHS `behavioralValue`
of a terminal tree returns `p i` directly. The RHS `nodeStepValue` at a terminal node also returns
`p i`. -/
private lemma behavioralValue_eq_nodeStepValue_terminal [DecidableEq I]
    (T : FinitePerfectInfoTree I E)
    (σ : T.toExtensiveForm.BehavioralStrategy) (h : List E) (i : I)
    (p : I → ℝ) (hsub : T.subtreeAt h = .terminal p) :
    (T.subtreeAt h).behavioralValue
        (T.subtreeBehavioral (fun h' => σ.atHistory h') h) i =
      nodeStepValue T.toExtensiveForm σ h i (T.toExtensiveForm.tree.nodeKind h) rfl
        (nodeKind_ne_chanceGeneral T h) (fun _ _ _ => 0) 1
        (fun σ' h' i' =>
          (T.subtreeAt h').behavioralValue
            (T.subtreeBehavioral (fun h'' => σ'.atHistory h'') h') i') := by
  -- LHS: rewriting by `hsub` gives `(.terminal p).behavioralValue _ i = p i`.
  -- RHS: `tree.nodeKind h = (T.subtreeAt h).rootNodeKind = .terminal p`.
  have hk : T.toExtensiveForm.tree.nodeKind h = .terminal p := by
    change T.nodeKindAt h = .terminal p
    unfold nodeKindAt rootNodeKind; rw [hsub]
  -- Reduce LHS via HEq congruence (motive issues prevent a direct rewrite).
  have hLHS : (T.subtreeAt h).behavioralValue
      (T.subtreeBehavioral (fun h' => σ.atHistory h') h) i = p i := by
    have : (FinitePerfectInfoTree.terminal (I := I) (E := E) p).behavioralValue
        (cast (by rw [hsub]) (T.subtreeBehavioral (fun h' => σ.atHistory h') h)) i = p i := rfl
    refine (behavioralValue_heq_congr_local hsub ?_ i).trans this
    exact (cast_heq _ _).symm
  rw [hLHS, nodeStepValue_discr_congr T.toExtensiveForm σ h i rfl hk
    (nodeKind_ne_chanceGeneral T h) (by simp)]
  exact (nodeStepValue_terminal _ σ h i p hk _ _ _ _).symm

/-- Bellman bridge — player (decision) case. When
`T.subtreeAt h = .decision mover Choice emit
child`, the LHS expands to a sum over `Choice` of root
simplex × child-subtree behavioralValue; the RHS via `nodeStepValue_player` expands to a sum over
`Choice` of `playerBehavior.val × (0 + 1 ·
V _ _ _)`. -/
private lemma behavioralValue_eq_nodeStepValue_decision [DecidableEq I]
    (T : FinitePerfectInfoTree I E)
    (σ : T.toExtensiveForm.BehavioralStrategy) (h : List E) (i : I)
    (mover : I) (Choice : Type u)
    [Fintype Choice] [DecidableEq Choice] [Nonempty Choice] [Inhabited Choice]
    (emit : Choice ↪ E) (child : Choice → FinitePerfectInfoTree I E)
    (hsub : T.subtreeAt h = .decision mover Choice emit child) :
    (T.subtreeAt h).behavioralValue
        (T.subtreeBehavioral (fun h' => σ.atHistory h') h) i =
      nodeStepValue T.toExtensiveForm σ h i (T.toExtensiveForm.tree.nodeKind h) rfl
        (nodeKind_ne_chanceGeneral T h) (fun _ _ _ => 0) 1
        (fun σ' h' i' =>
          (T.subtreeAt h').behavioralValue
            (T.subtreeBehavioral (fun h'' => σ'.atHistory h'') h') i') := by
  -- The player-node kind at history `h`.
  set n : PlayerNode I E := { mover := mover, Choice := Choice, emit := emit } with hn
  have hk : T.toExtensiveForm.tree.nodeKind h = .player n := by
    change T.nodeKindAt h = .player n
    unfold nodeKindAt rootNodeKind; rw [hsub]
  set σ' : T.RawBehavioral := fun h' => σ.atHistory h' with hσ'
  -- Rewrite RHS so the discriminant is `.player n`.
  rw [nodeStepValue_discr_congr T.toExtensiveForm σ h i rfl hk
    (nodeKind_ne_chanceGeneral T h) (by simp), nodeStepValue_player]
  -- Clean up `0 + 1 * x = x` in each summand on the RHS.
  simp only [zero_add, one_mul]
  -- Reduce LHS via HEq congruence with the decision-form. We use `eqRec_heq_self.symm` to swap.
  set σD := hsub ▸ T.subtreeBehavioral σ' h with hσD
  have hHEq : HEq (T.subtreeBehavioral σ' h) σD := by
    rw [hσD]
    exact (eqRec_heq_self (motive := fun T _ => T.RawBehavioral)
      (T.subtreeBehavioral σ' h) hsub).symm
  rw [behavioralValue_heq_congr_local hsub hHEq i]
  -- LHS is now `(.decision mover Choice emit child).behavioralValue σD i`. Unfold it.
  change (let beh : stdSimplex ℝ Choice := σD []
      ∑ c : Choice, (beh : Choice → ℝ) c *
        (child c).behavioralValue
          (shiftBehavioralAtChoice mover Choice emit child σD c) i) =
    ∑ c, ((σ.playerBehavior h hk) : Choice → ℝ) c *
      (T.subtreeAt (h ++ [n.emit c])).behavioralValue
        (T.subtreeBehavioral σ' (h ++ [n.emit c])) i
  dsimp only
  -- HEq facts between root simplices and shift/subtree-append.
  have hRoot_HEq : HEq (σD []) (σ.playerBehavior h hk) := by
    -- σD [] ≍ (T.subtreeBehavioral σ' h) [] (drop ▸), and the latter ≍ σ' h ≍ σ.atHistory h.
    have h1 : HEq σD (T.subtreeBehavioral σ' h) := by
      rw [hσD]
      exact eqRec_heq (φ := fun T' => T'.RawBehavioral) hsub (T.subtreeBehavioral σ' h)
    have h2 : HEq (σD []) (T.subtreeBehavioral σ' h []) :=
      dcongr_heq (a₁ := ([] : List E)) (a₂ := ([] : List E))
        HEq.rfl
        (fun rest1 rest2 hrest => by cases eq_of_heq hrest; rw [hsub])
        (fun _ _ => h1)
    have h3 : HEq (T.subtreeBehavioral σ' h []) (σ' h) := by
      unfold subtreeBehavioral
      simp only [cast_heq_iff_heq]
      rw [List.append_nil]
      rfl
    have h4 : σ' h = σ.atHistory h := rfl
    have h5 : HEq (σ.playerBehavior h hk) (σ.atHistory h) := by
      unfold ExtensiveForm.BehavioralStrategy.playerBehavior
      exact cast_heq _ _
    exact h2.trans (h3.trans (h4 ▸ h5.symm))
  have hRoot_eq : σD [] = σ.playerBehavior h hk := eq_of_heq hRoot_HEq
  refine Finset.sum_congr rfl fun c _ => ?_
  congr 1
  · -- First factor: pointwise root simplex values.
    exact congrArg (fun (x : stdSimplex ℝ Choice) => (x : Choice → ℝ) c) hRoot_eq
  · -- Second factor: `(child c).behavioralValue (shift σD c) i =
    --                  (T.subtreeAt (h ++ [emit c])).behavioralValue (T.subtreeBehavioral σ' _) i`.
    -- Use `subtreeAt_append` and the shift HEq lemma:
    -- `T.subtreeAt (h ++ [emit c]) = (T.subtreeAt h).subtreeAt [emit c] = child c`.
    have hSub_chain : T.subtreeAt (h ++ [emit c]) = child c := by
      rw [T.subtreeAt_append h [emit c], hsub, subtreeAt_emit_cons]
      cases child c <;> rfl
    -- The subtree behavior at `h ++ [emit c]` is HEq to `shiftBehavioralAtChoice _ _ _ _ σD c`.
    refine behavioralValue_heq_congr_local hSub_chain.symm ?_ i
    -- Need: HEq (shiftBehavioralAtChoice _ _ _ _ σD c) (T.subtreeBehavioral σ' (h ++ [emit c])).
    -- Both pointwise produce `σ' (h ++ [emit c] ++ rest)`.
    refine Function.hfunext rfl fun rest1 rest2 hrest => ?_
    cases eq_of_heq hrest
    -- Reduce both sides to `σ' (h ++ emit c :: rest1)` up to cast, then handle the list-append eq.
    have hStep1 : HEq (shiftBehavioralAtChoice mover Choice emit child σD c rest1)
        (σD (emit c :: rest1)) := by
      unfold shiftBehavioralAtChoice
      exact cast_heq _ _
    have h1' : HEq σD (T.subtreeBehavioral σ' h) := by
      rw [hσD]
      exact eqRec_heq (φ := fun T' => T'.RawBehavioral) hsub (T.subtreeBehavioral σ' h)
    have hStep2 : HEq (σD (emit c :: rest1)) (T.subtreeBehavioral σ' h (emit c :: rest1)) :=
      dcongr_heq (a₁ := emit c :: rest1) (a₂ := emit c :: rest1) HEq.rfl
        (fun _ _ hr => by cases eq_of_heq hr; rw [hsub]) (fun _ _ => h1')
    have hStep3 : HEq (T.subtreeBehavioral σ' h (emit c :: rest1))
        (σ' (h ++ (emit c :: rest1))) := by
      unfold subtreeBehavioral
      exact cast_heq _ _
    have hLists : h ++ (emit c :: rest1) = h ++ [emit c] ++ rest1 := by simp
    have hStep4 : HEq (σ' (h ++ (emit c :: rest1))) (σ' (h ++ [emit c] ++ rest1)) := by
      rw [hLists]
    have hStep5 : HEq (T.subtreeBehavioral σ' (h ++ [emit c]) rest1)
        (σ' (h ++ [emit c] ++ rest1)) := by
      unfold subtreeBehavioral
      exact cast_heq _ _
    exact (hStep1.trans (hStep2.trans (hStep3.trans hStep4))).trans hStep5.symm

/-- Existence-form dichotomy on a subtree: It is either terminal or a decision node. -/
private lemma subtreeAt_dichotomy (T : FinitePerfectInfoTree I E) (h : List E) :
    (∃ p, T.subtreeAt h = .terminal p) ∨
      ∃ (mover : I) (Choice : Type u)
        (_ : Fintype Choice) (_ : DecidableEq Choice) (_ : Nonempty Choice) (_ : Inhabited Choice)
        (emit : Choice ↪ E) (child : Choice → FinitePerfectInfoTree I E),
        T.subtreeAt h = .decision mover Choice emit child := by
  cases T.subtreeAt h with
  | terminal p => exact Or.inl ⟨p, rfl⟩
  | decision mover Choice emit child =>
      exact Or.inr ⟨mover, Choice, _, _, _, _, emit, child, rfl⟩

/-- The Bellman equation `continuationValue_eq` for the perfect-info `toExtensiveGame`
construction: Combines the terminal and decision bridges. -/
lemma continuationValue_eq_bridge [DecidableEq I]
    (T : FinitePerfectInfoTree I E)
    (σ : T.toExtensiveForm.BehavioralStrategy) (h : List E) (i : I) :
    (T.subtreeAt h).behavioralValue
        (T.subtreeBehavioral (fun h' => σ.atHistory h') h) i =
      nodeStepValue T.toExtensiveForm σ h i (T.toExtensiveForm.tree.nodeKind h) rfl
        (nodeKind_ne_chanceGeneral T h) (fun _ _ _ => 0) 1
        (fun σ' h' i' =>
          (T.subtreeAt h').behavioralValue
            (T.subtreeBehavioral (fun h'' => σ'.atHistory h'') h') i') := by
  rcases T.subtreeAt_dichotomy h with ⟨p, hsub⟩ | ⟨mover, Choice, _, _, _, _, emit, child, hsub⟩
  · exact behavioralValue_eq_nodeStepValue_terminal T σ h i p hsub
  · exact behavioralValue_eq_nodeStepValue_decision T σ h i mover Choice emit child hsub

/-- A scoped finite tree as an extensive game.

The continuation value is the σ-dependent expected payoff at the subtree under the restricted
strategy. The unilateral-deviation relation is fixed once and for all by
`ExtensiveForm.unilateralDeviation`; on a perfect-information tree it specializes to "agree at
every non-`i`-mover history" — see `unilateralDeviation_iff_isMoverAt`. Subgame perfection is
derived (not supplied) via `ExtensiveGame.IsSubgamePerfectEquilibrium = spePred.IsEquilibrium`. The
bridge theorem `isSubgamePerfectStrategy_iff_spePred` identifies the recursive `Choice`-indexed
predicate `IsSubgamePerfectStrategy s` with
`spePred.IsEquilibrium (LocalBehavioralStrategy.toBehavioralStrategy T s)` on the canonical
embedding. -/
noncomputable def toExtensiveGame [DecidableEq I] (T : FinitePerfectInfoTree I E) :
    ExtensiveGame I E where
  toExtensiveForm := T.toExtensiveForm
  -- TODO §3: replace with `ExtensiveGame.ofFiniteHorizonTree T.toExtensiveForm T.finiteDepth
  -- T.no_chanceGeneral` once `FinitePerfectInfoTree.depth`, `finiteDepth`, and `no_chanceGeneral`
  -- prerequisites are in place. The hand-rolled `behavioralValue` definition is preserved as a
  -- bridge; downstream proofs in OneShot.lean/SPE.lean still see the same shape.
  stepPayoff := fun _ _ _ => 0
  discount := 1
  discount_mem := ⟨zero_le_one, le_refl _⟩
  -- Finite perfect-info trees have only terminal or player nodes (no chance / no joint).
  no_chanceGeneral := nodeKind_ne_chanceGeneral T
  continuationValue σ h i :=
    (T.subtreeAt h).behavioralValue (T.subtreeBehavioral (fun h' => σ.atHistory h') h) i
  continuationValue_eq := T.continuationValue_eq_bridge
  continuationValue_unique := Or.inl ⟨T.depth, T.finiteDepth⟩

/-- A finite perfect-info tree has no joint or chance nodes anywhere on its embedded tree: Every
history reaches either a terminal or a single-player decision node. -/
lemma toGameTree_nodeKind_cases (T : FinitePerfectInfoTree I E) (h : List E) :
    (∃ payoff, T.toGameTree.nodeKind h = .terminal payoff) ∨
      (∃ n, T.toGameTree.nodeKind h = .player n) := by
  change (∃ payoff, T.nodeKindAt h = .terminal payoff) ∨ (∃ n, T.nodeKindAt h = .player n)
  unfold nodeKindAt rootNodeKind
  cases T.subtreeAt h with
  | terminal payoff => left; exact ⟨payoff, rfl⟩
  | decision mover Choice emit child => right; exact ⟨_, rfl⟩

/-- At histories where player `j` does not move on a perfect-info tree's embedded game tree, the
strategy carrier type is a `Subsingleton`. -/
lemma toExtensiveForm_iChoiceType_subsingleton [DecidableEq I]
    (T : FinitePerfectInfoTree I E) (j : I) (obs : List E)
    (hnotMove : ¬ (T.toGameTree.nodeKind obs).movesAt j) :
    Subsingleton (T.toExtensiveForm.info.iChoiceType j obs) := by
  change Subsingleton ((T.toGameTree.nodeKind obs).iChoiceTypeAt' j)
  rcases T.toGameTree_nodeKind_cases obs with ⟨payoff, hk⟩ | ⟨n, hk⟩
  · rw [hk]; exact (inferInstance : Subsingleton PUnit)
  · have hne : n.mover ≠ j := fun habs => hnotMove (by rw [hk]; exact habs)
    rw [hk]
    unfold NodeKind.iChoiceTypeAt'
    open Classical in simp only [if_neg hne]
    exact (inferInstance : Subsingleton PUnit)

/-- At non-mover coordinates on a perfect-info tree, any two behavioral strategies agree. -/
lemma toExtensiveForm_eq_at_nonMover [DecidableEq I]
    (T : FinitePerfectInfoTree I E) (σ τ : T.toExtensiveForm.BehavioralStrategy)
    (j : I) (obs : List E) (hnotMove : ¬ (T.toGameTree.nodeKind obs).movesAt j) :
    σ j obs = τ j obs :=
  have : Subsingleton (T.toExtensiveForm.info.iChoiceType j obs) :=
    T.toExtensiveForm_iChoiceType_subsingleton j obs hnotMove
  Subsingleton.elim _ _

/-- If the embedded game tree's `nodeKind` at `h` is `.player n`, then for any `j` equal to
`n.mover` we have `T.isMoverAt h j`. Useful via `habs ▸ this : T.isMoverAt h j`. -/
private lemma isMoverAt_of_nodeKind_player (T : FinitePerfectInfoTree I E) {h : List E}
    {n : PlayerNode I E} {j : I} (hk : T.toGameTree.nodeKind h = .player n)
    (hj : n.mover = j) : T.isMoverAt h j := by
  change T.nodeKindAt h = .player n at hk
  unfold FinitePerfectInfoTree.nodeKindAt FinitePerfectInfoTree.rootNodeKind at hk
  unfold FinitePerfectInfoTree.isMoverAt
  cases hsub : T.subtreeAt h with
  | terminal _ => rw [hsub] at hk; exact absurd hk (by simp)
  | decision mover Choice emit child => rw [hsub] at hk; cases hk; exact hj

/-- On a perfect-information finite tree, the canonical extensive-form unilateral-deviation
predicate is equivalent to the `atHistory` projections agreeing at every history where player `i`
is not the mover. -/
lemma unilateralDeviation_iff_isMoverAt [DecidableEq I]
    (T : FinitePerfectInfoTree I E) (i : I)
    (σ τ : T.toExtensiveForm.BehavioralStrategy) :
    T.toExtensiveForm.unilateralDeviation i σ τ ↔
      ∀ h, ¬ T.isMoverAt h i → σ.atHistory h = τ.atHistory h := by
  refine ⟨fun hdev h hnot => ?_, fun h_pa j obs hne => ?_⟩
  · rcases T.toGameTree_nodeKind_cases h with ⟨payoff, hk⟩ | ⟨n, hk⟩
    · exact eq_of_heq
        ((σ.atHistory_terminal_heq hk).trans (τ.atHistory_terminal_heq hk).symm)
    · have hne : n.mover ≠ i := fun habs => hnot (T.isMoverAt_of_nodeKind_player hk habs)
      have hpc : τ n.mover (T.toExtensiveForm.info.observe n.mover h) =
                  σ n.mover (T.toExtensiveForm.info.observe n.mover h) :=
        hdev n.mover _ hne
      exact eq_of_heq <|
        (σ.atHistory_player_heq hk).trans <|
          (heq_of_eq hpc.symm).trans (τ.atHistory_player_heq hk).symm
  · by_cases hmove : (T.toGameTree.nodeKind obs).movesAt j
    · rcases T.toGameTree_nodeKind_cases obs with ⟨payoff, hk⟩ | ⟨n, hk⟩
      · rw [hk] at hmove; exact absurd hmove id
      · have hjn : n.mover = j := by rw [hk] at hmove; exact hmove
        -- If `T.isMoverAt obs i` then by the structure of decision nodes `n.mover = i`,
        -- contradicting `hne : i ≠ j` once combined with `hjn`.
        have hnoti : ¬ T.isMoverAt obs i := by
          intro hi
          apply hne
          change T.nodeKindAt obs = .player n at hk
          unfold FinitePerfectInfoTree.nodeKindAt FinitePerfectInfoTree.rootNodeKind at hk
          unfold FinitePerfectInfoTree.isMoverAt at hi
          cases hsub : T.subtreeAt obs with
          | terminal _ => rw [hsub] at hi; exact hi.elim
          | decision mover Choice emit child =>
              rw [hsub] at hk hi; cases hk; exact (hi.symm.trans hjn).symm
        have heq_at : σ.atHistory obs = τ.atHistory obs := h_pa obs hnoti
        have hobs : T.toExtensiveForm.info.observe n.mover obs = obs := rfl
        have hσ : HEq (σ.atHistory obs) (σ n.mover obs) := by
          have := σ.atHistory_player_heq hk; rw [hobs] at this; exact this
        have hτ : HEq (τ.atHistory obs) (τ n.mover obs) := by
          have := τ.atHistory_player_heq hk; rw [hobs] at this; exact this
        have h_nm : σ n.mover obs = τ n.mover obs :=
          eq_of_heq (hσ.symm.trans ((heq_of_eq heq_at).trans hτ))
        rw [hjn] at h_nm
        exact h_nm.symm
    · -- j doesn't move at obs: subsingleton on the strategy carrier.
      exact (T.toExtensiveForm_eq_at_nonMover σ τ j obs hmove).symm

/-- Round-trip: Applying `BehavioralStrategy.ofPerfectInfo` and then projecting back via
`atHistory` recovers the original raw behavior. On a finite perfect-information tree, only terminal
and player nodes are reachable; both are handled via the `atHistory` HEq kit. -/
theorem
atHistory_ofPerfectInfo [DecidableEq I]
    (T : FinitePerfectInfoTree I E) (σ : T.RawBehavioral) (h : List E) :
    (ExtensiveForm.BehavioralStrategy.ofPerfectInfo σ).atHistory h = σ h := by
  rcases T.toGameTree_nodeKind_cases h with ⟨payoff, hk⟩ | ⟨n, hk⟩
  · -- Terminal behavior is subsingleton after rewriting by `hk`.
    have hSub : Subsingleton (T.toGameTree.nodeKind h).Behavior := by
      rw [hk]; change Subsingleton PUnit; infer_instance
    exact hSub.elim _ _
  · -- The player branch aligns `atHistory`, `simplexTransport`, and `iLocalBehavior` by HEq.
    have h_at : HEq ((ExtensiveForm.BehavioralStrategy.ofPerfectInfo σ).atHistory h)
        ((ExtensiveForm.BehavioralStrategy.ofPerfectInfo σ) n.mover
          (T.toExtensiveForm.info.observe n.mover h)) :=
      (ExtensiveForm.BehavioralStrategy.ofPerfectInfo σ).atHistory_player_heq hk
    have hm : (T.toGameTree.nodeKind h).movesAt n.mover := by rw [hk]; rfl
    have hofp : (ExtensiveForm.BehavioralStrategy.ofPerfectInfo σ) n.mover h =
        simplexTransport
          ((NodeKind.iChoiceTypeAt'_eq_iChoiceTypeAt _ _ hm).symm)
          ((T.toGameTree.nodeKind h).iLocalBehavior n.mover hm (σ h)) := by
      unfold ExtensiveForm.BehavioralStrategy.ofPerfectInfo
      rw [dif_pos hm]; rfl
    have h_ilb : HEq ((T.toGameTree.nodeKind h).iLocalBehavior n.mover hm (σ h)) (σ h) := by
      have key : ∀ (k1 k2 : NodeKind I E) (he : k1 = k2) (hm1 : k1.movesAt n.mover)
          (b1 : k1.Behavior),
          (∀ m, k2 = .player m → HEq (k1.iLocalBehavior n.mover hm1 b1) b1) := by
        intro k1 k2 he hm1 b1 m h_eq
        subst he; subst h_eq; rfl
      exact key _ _ rfl hm (σ h) n hk
    have hobs : T.toExtensiveForm.info.observe n.mover h = h := rfl
    rw [hobs, hofp] at h_at
    exact eq_of_heq (h_at.trans ((simplexTransport_heq _ _).trans h_ilb))

end FinitePerfectInfoTree

end Econlib.GameTheory
