module

public import Econlib.GameTheory.ExtensiveForm.Core.Node

/-!
# Game trees, information structures, and extensive forms

This file defines the history-based core of the extensive-form API (Kuhn 1953). A `GameTree`
assigns a `NodeKind` to every finite public history, an `InfoStructure` records each player's
observations and information-set choice types, and an `ExtensiveForm` bundles the two with the
coherence axiom relating node-local choices to information-set choices.

The file also provides the canonical perfect-information builders. Strategy-level concepts
(`BehavioralStrategy`, `atHistory`, `unilateralDeviation`, `stepProb`, `finitePrefixProb`) live in
`Strategy.lean`; `ExtensiveGame` and `spePred` live in `Game.lean`.

## Main definitions

* `GameTree`: History-based game form.
* `InfoStructure`: Observation and information-set choice structure.
* `ExtensiveForm`: Game tree paired with information structure and choice-type coherence.
* `InfoStructure.perfectInfo`: Perfect-information structure on a game tree.
* `ExtensiveForm.ofGameTreePerfectInfo`: Perfect-information extensive form from a game tree.

## Main statements

* `NodeKind.iChoiceTypeAt'_eq_iChoiceTypeAt`: Used to prove compatibility for perfect information.

## References

* Kuhn, H. W. 1953. “Extensive Games and the Problem of Information.” In *Contributions to the
  Theory of Games, Volume II*, edited by H. W. Kuhn and A. W. Tucker. Princeton University Press.

## Tags

extensive form, game tree, information structure
-/

@[expose] public noncomputable section

open BigOperators Econlib.Probability

namespace Econlib.GameTheory

universe u

/-- A history-based game form. `nodeKind h` describes the node reached after finite public history
`h`. -/
structure GameTree (I : Type u) (E : Type u) where
  /-- The node kind reached after a finite public history. -/
  nodeKind : List E → NodeKind I E

/-- Information structure: Each player has an observation space at every public history, plus a
declared per-info-set choice type with `[Fintype]`, `[DecidableEq]`, `[Inhabited]` brackets.

**Builder discipline:** define `iChoiceType i obs` so that for every reachable history `h` in `i`'s
information set, `iChoiceType i (observe i h)` unfolds definitionally to
`(tree.nodeKind h).iChoiceTypeAt i hm` (canonical-rep pattern). Under this convention,
`iChoice_compatible` is `rfl` at the canonical rep and a small propositional equality elsewhere;
the Fintype-instance diamond is bridged inside `simplexTransport` (see `Strategy.lean`) and remains
invisible to consumers reading `(σ.atHistory h).val c`. -/
structure InfoStructure (I : Type u) (E : Type u) where
  /-- Observation space for player `i`. -/
  Obs : I → Type u
  /-- Observation generated by player `i` at public history `h`. -/
  observe : (i : I) → List E → Obs i
  /-- The legal choice type at player `i`'s info set with observation `obs`. -/
  iChoiceType : (i : I) → Obs i → Type u
  /-- `iChoiceType` is finite at every info set. -/
  iChoiceFintype : ∀ i obs, Fintype (iChoiceType i obs)
  /-- `iChoiceType` has decidable equality at every info set. -/
  iChoiceDecEq : ∀ i obs, DecidableEq (iChoiceType i obs)
  /-- `iChoiceType` is inhabited at every info set — rules out empty-carrier info sets at the type
  level. -/
  iChoiceInhabited : ∀ i obs, Inhabited (iChoiceType i obs)

attribute [instance] InfoStructure.iChoiceFintype InfoStructure.iChoiceDecEq
  InfoStructure.iChoiceInhabited

/-- Bundled extensive form: A game tree paired with an information structure. The
`iChoice_compatible` field is the granular per-player choice-type coherence axiom: At every history
`h` where player `i` moves, the tree's node-local choice type at `i` coincides with the
info-structure declaration at `i`'s observation of `h`. -/
structure ExtensiveForm (I : Type u) (E : Type u) where
  /-- The underlying game tree. -/
  tree : GameTree I E
  /-- The information structure. -/
  info : InfoStructure I E
  /-- Per-player local choice-type coherence: The tree's choice type at `(h, i)` equals the
  info-structure declaration at `i`'s observation of `h`. -/
  iChoice_compatible : ∀ (i : I) (h : List E) (hm : (tree.nodeKind h).movesAt i),
    (tree.nodeKind h).iChoiceTypeAt i hm = info.iChoiceType i (info.observe i h)

namespace InfoStructure

variable {I E : Type u} [DecidableEq I]

/-- The perfect-information observation structure on a `GameTree t`: Every player observes the full
public history, and the per-info-set choice type at observation `obs` is the total node-local
choice type `(t.nodeKind obs).iChoiceTypeAt' i` (which returns `PUnit` for nodes where `i` doesn't
move). This builder discipline ensures `iChoice_compatible` is a small propositional equality
(`iChoiceTypeAt'_eq_iChoiceTypeAt`) rather than a non-trivial transport. -/
noncomputable def perfectInfo (t : GameTree I E) : InfoStructure I E where
  Obs _ := List E
  observe _ h := h
  iChoiceType i obs := (t.nodeKind obs).iChoiceTypeAt' i
  iChoiceFintype i obs := NodeKind.instFintypeIChoiceTypeAt' (t.nodeKind obs) i
  iChoiceDecEq i obs := NodeKind.instDecidableEqIChoiceTypeAt' (t.nodeKind obs) i
  iChoiceInhabited i obs := NodeKind.instInhabitedIChoiceTypeAt' (t.nodeKind obs) i

instance instDecidableEqPerfectInfoObs [DecidableEq E] (t : GameTree I E) (i : I) :
    DecidableEq ((perfectInfo t).Obs i) :=
  show DecidableEq (List E) from inferInstance

end InfoStructure

namespace ExtensiveForm

variable {I E : Type u}

/-- The perfect-information extensive form on a tree. The `iChoice_compatible` field follows from
the total-vs-partial bridge lemma `NodeKind.iChoiceTypeAt'_eq_iChoiceTypeAt`. -/
noncomputable def ofGameTreePerfectInfo [DecidableEq I] (t : GameTree I E) :
    ExtensiveForm I E where
  tree := t
  info := InfoStructure.perfectInfo t
  iChoice_compatible := fun _ _ hm =>
    (NodeKind.iChoiceTypeAt'_eq_iChoiceTypeAt _ _ hm).symm

end ExtensiveForm

end Econlib.GameTheory
